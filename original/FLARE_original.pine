//@version=6
// Focused Spaceman calendar map + explicitly named boxes + price-first signals.
// Original full indicator remains a separate backup. Source checks are not compilation.
// SpacemanBTC framework credit: sbtnc. Existing calendar/control code preserved.
indicator('FLARE_NvME | Spaceman Boxes Checked', 'FLARE Boxes',
     overlay=true, max_lines_count=500, max_labels_count=500,
     max_boxes_count=500, max_bars_back=1000, dynamic_requests=true)

if barstate.isfirst and (not chart.is_standard or not timeframe.isintraday or timeframe.in_seconds() < 60 or timeframe.in_seconds() > 14400)
    runtime.error('Use standard time-based candles from 1 minute through 4 hours.')

gMarkerHistory = "Display • Secondary marker history"
auxMarkerLimit = input.int(80, "Secondary markers to retain", minval = 10, maxval = 90, group = gMarkerHistory,
     tooltip = "Bounded optional marker history; Confirmed markers are never backdated; oldest markers expire uniformly.")
var array<label> auxMarkers = array.new<label>()
f_auxMarker(bool enabled, float price, string caption, string markerStyle, string markerLocation, color markerColor, color captionColor, string hint) =>
    if enabled and barstate.isconfirmed
        if array.size(auxMarkers) >= auxMarkerLimit
            label.delete(array.shift(auxMarkers))
        label marker = label.new(bar_index, price, caption, yloc = markerLocation,
             style = markerStyle, color = markerColor, textcolor = captionColor,
             size = size.tiny, tooltip = hint, force_overlay = true)
        array.push(auxMarkers, marker)

displayStyle = input.string(defval='Standard', title='Display Style', options=['Standard', 'Right Anchored'], inline='Display')
mergebool = input.bool(defval=true, title='Merge Levels?', inline='Display')
distanceright = input.int(defval=20, title='Distance', minval=5, maxval=500, inline='Dist')
radistance = input.int(defval=250, title='Anchor Distance', minval=5, maxval=500, inline='Dist')
