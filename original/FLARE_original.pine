array<int> mapTimes = array.from(intra_time, intrah_time, intral_time, intrah_time, daily_time, dailyh_time, dailyl_time, dailyh_time, monday_time, monday_time, monday_time, monday_time, weekly_time, weeklyh_time, weeklyl_time, weeklyh_time, monthly_time, monthlyh_time, monthlyl_time, monthlyh_time, quarterly_time, quarterlyh_time, quarterlyl_time, quarterlyh_time, yearly_time, yearlyh_time, yearlyl_time, yearly_time, londontime, londontime, londontime, ustime, ustime, ustime, asiatime, asiatime, asiatime, weekly_time, weekly_time, weekly_time, yearly_time, yearly_time, yearly_time, yearly_time, yearly_time, yearly_time, quarterly_time, quarterly_time, quarterly_time, quarterly_time, quarterly_time, quarterly_time, monthly_time, monthly_time, monthly_time, monthly_time, monthly_time, monthly_time, weekly_time, weekly_time, weekly_time, daily_time, daily_time, daily_time, daily_time, daily_time, daily_time)
