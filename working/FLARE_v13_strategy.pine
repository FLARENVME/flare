wbShow = input.bool(true, "Show Year → Quarter → Month → Week → Day boxes", group = gWB)
wbAutoView = input.bool(true, "Auto boxes by chart timeframe", group=gWB, tooltip="1–15m: nearest boxes only. 30m and above: main weekly/monthly boxes. Drawing only; signal rules do not change.")
