array<color> mapColors = array.from(IntraColor, IntraColor, IntraColor, IntraColor, DailyColor, DailyColor, DailyColor, DailyColor, MondayColor, MondayColor, MondayColor, MondayColor, WeeklyColor, WeeklyColor, WeeklyColor, WeeklyColor, MonthlyColor, MonthlyColor, MonthlyColor, MonthlyColor, quarterlyColor, quarterlyColor, quarterlyColor, quarterlyColor, YearlyColor, YearlyColor, YearlyColor, YearlyColor, LondonColor, LondonColor, LondonColor, USColor, USColor, USColor, AsiaColor, AsiaColor, AsiaColor, WeeklyColor, WeeklyColor, WeeklyColor, YearlyColor, YearlyColor, YearlyColor, YearlyColor, YearlyColor, YearlyColor, quarterlyColor, quarterlyColor, quarterlyColor, quarterlyColor, quarterlyColor, quarterlyColor, MonthlyColor, MonthlyColor, MonthlyColor, MonthlyColor, MonthlyColor, MonthlyColor, WeeklyColor, WeeklyColor, WeeklyColor, DailyColor, DailyColor, DailyColor, DailyColor, DailyColor, DailyColor)
