wbNearAtr = input.float(3.0, "Small charts • distance from price (ATR)", minval=0.5, step=0.5, group=gWB)
wbYellowDim = input.int(97, "Yellow fill dimmer • higher = dimmer", minval=90, maxval=100, group=gWB)
wbInherited = input.bool(true, "Use named Spaceman boxes", group=gWB, tooltip="Established named ranges remain fixed as price moves. No automatic nearest-calendar pairing. Larger structures draw farther left.")
wbWeekPair = input.string("Weekly Open / Previous Month High", "Weekly reaction box boundaries", options=["Weekly Open / Previous Month High","Weekly Open / Previous Week Mid","Previous Week Mid / Previous Month High","Previous Week High / Previous Week Low"], group=gWB)
wbWeekOpenMid = input.bool(true, "Also show Weekly Open / Previous Week Mid", group=gWB)
wbNestedDepth = input.int(2, "Narrow each established box • halves", minval=0, maxval=2, group=gWB)
wbDailyEstablished = input.bool(false, "Enable Daily Open / Monday Low after Monday completes", group=gWB, tooltip="Off by default: this does not become a weekly box. No alerts use this pair while Monday is developing.")
// FLARE v3 CHANGE: adjacent mapped-level box construction (default) with the original named-range path kept.
gV3 = "v3 • Adjacent mapped-level boxes"
boxBuild = input.string("Adjacent mapped levels (v3)", "Box construction", options=["Adjacent mapped levels (v3)","Original named-range midpoint"], group=gV3,
     tooltip="v3: every enabled calendar level is a boundary. For adjacent levels D < L < U the reaction areas of L are (D+L)/2..L and L..(L+U)/2. A box is the space between two adjacent levels; endpoints keep name, weight and developing status. Original: named-range midpoints as before.")
bool boxV3 = boxBuild == "Adjacent mapped levels (v3)"
v3NearSmall = input.int(2, "Small charts (≤15m) • boxes above and below price", minval=1, maxval=5, group=gV3)
v3NearLarge = input.int(3, "Larger charts • boxes above and below price", minval=1, maxval=6, group=gV3)
v3LargeMinW = input.int(4, "Larger charts • emphasize boundaries with weight ≥", minval=1, maxval=7, group=gV3, tooltip="Weights: Yearly 7, Quarterly 6, Monthly 5, Weekly 4, Monday 3, Daily 2, 4H/sessions 1. Stronger = hypothesis, exposed only.")
v3ShowStates = input.bool(true, "Tiny state labels: HOLD / REJ / BRK / FAIL-BRK", group=gV3)
v3FailBars = input.int(6, "FAIL-BRK • return inside within bars", minval=1, maxval=50, group=gV3)
v3ShowNR = input.bool(true, "Failed-to-reach marker (NR)", group=gV3)
v3FailN = input.int(3, "NR • stalled pushes before marker", minval=2, maxval=10, group=gV3)
v3PushPct = input.int(25, "NR • push counts from box % toward the boundary", minval=0, maxval=95, group=gV3)
v3DevSignals = input.bool(true, "Allow signals at developing boundaries (tagged)", group=gV3)
// Slot weight: larger / longer-established references weigh more (hypothesis, exposed only).
f_v3Weight(int slot) =>
    slot <= 3 ? 1 : slot <= 7 ? 2 : (slot <= 10 or slot == 36) ? 3 : slot <= 14 ? 4 : slot <= 18 ? 5 : slot <= 22 ? 6 : slot <= 26 ? 7 : 1
// Developing: Monday H/L/Mid during the CME Monday trading day (incl. Sunday evening); current-year H/L/Mid.
f_v3Dev(int slot) =>
    (slot >= 8 and slot <= 10 and flareMonday) or (slot >= 24 and slot <= 26)
f_v3Tier(int w) =>
    w == 7 ? 0 : w == 6 ? 1 : w == 5 ? 2 : w == 4 ? 3 : w == 3 ? 5 : 4
var array<float> v3P = array.new_float()
var array<string> v3N = array.new_string()
var array<int> v3W = array.new_int()
var array<bool> v3D = array.new_bool()
// FLARE v5 CHANGE: boundary weight / established arrays (declared before f_v3Hierarchy uses them)
var array<int> v5HierW = array.new_int()
var array<bool> v5HierEst = array.new_bool()
// FLARE v9 CHANGE: map slot per v3 boundary (strongest member when merged) and per hierarchy triple
var array<int> v9SlotArr = array.new_int()
var array<int> v9HierSlot = array.new_int()

