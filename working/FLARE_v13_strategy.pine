// Calendar reference data. Lower calendar periods use last-intrabar sampling
// for current labels on a larger chart; those are contextual reference levels.
chartSeconds = timeframe.in_seconds()
f_period(simple string tf) =>
    request.security(syminfo.tickerid,tf,[time,open,time[1],high[1],low[1]],lookahead=timeframe.in_seconds(tf) >= chartSeconds ? barmerge.lookahead_on : barmerge.lookahead_off)
[daily_time, daily_open, dailyh_time, dailyh_open, dailyl_open] = f_period('D')
[weekly_time, weekly_open, weeklyh_time, weeklyh_open, weeklyl_open] = f_period('W')
[monthly_time, monthly_open, monthlyh_time, monthlyh_open, monthlyl_open] = f_period('M')
[quarterly_time, quarterly_open, quarterlyh_time, quarterlyh_open, quarterlyl_open] = f_period('3M')
[yearly_time, yearly_open, prevyear_time, prevyear_high, prevyear_low] = f_period('12M')
[intra_time, intra_open, intrah_time, intrah_open, intral_open] = f_period('240')
dailyl_time = dailyh_time
weeklyl_time = weeklyh_time
monthlyl_time = monthlyh_time
quarterlyl_time = quarterlyh_time
intral_time = intrah_time
// Running YTD extremes on source daily bars, with no final-year lookahead.
f_ytd() =>
    var float h = na
    var float l = na
    var bool complete = false
    if timeframe.change('12M') and not barstate.isfirst
        complete := true
        h := high
        l := low
    else if complete
        h := math.max(h, high)
        l := math.min(l, low)
    [h, l]
f_ytdClosed() =>
    [h,l] = f_ytd()
    [h[1],l[1],time[1]]
[ytdDailyH,ytdDailyL,ytdDailyStamp] = request.security(syminfo.tickerid,'D',f_ytdClosed(),lookahead=barmerge.lookahead_on)
[ytdLocalH,ytdLocalL] = f_ytd()
var float intradayYtdH = na
var float intradayYtdL = na
if timeframe.change('12M') and not barstate.isfirst
    intradayYtdH := high
    intradayYtdL := low
bool sameSeedYear = not na(ytdDailyStamp) and year(ytdDailyStamp) == year(time)
if chartSeconds < 86400 and sameSeedYear and not na(ytdDailyH)
    intradayYtdH := math.max(na(intradayYtdH) ? ytdDailyH : intradayYtdH,math.max(ytdDailyH,high))
    intradayYtdL := math.min(na(intradayYtdL) ? ytdDailyL : intradayYtdL,math.min(ytdDailyL,low))
else if chartSeconds < 86400 and not na(intradayYtdH)
    intradayYtdH := math.max(intradayYtdH,high)
    intradayYtdL := math.min(intradayYtdL,low)
yearlyh_open = chartSeconds < 86400 ? intradayYtdH : ytdLocalH
yearlyl_open = chartSeconds < 86400 ? intradayYtdL : ytdLocalL
yearlyh_time = yearly_time
yearlyl_time = yearly_time
// Monday reference: the CME trading day, not the chart's calendar date.
// For futures, Sunday evening belongs to Monday through time_tradingday.
// The range resets at the first Monday trading-day bar, updates live through
// Monday, then remains frozen for the rest of the week.
// Accumulate chart bars so Monday's final daily high/low is never visible early.
// A chart loaded midway through Monday waits for the next complete Monday start.
var float monday_high = na
var float monday_low = na
var float monday_open = na
var int monday_time = na
flareMonday = dayofweek(time_tradingday, 'UTC') == dayofweek.monday
flareNewTradingDay = ta.change(time_tradingday) != 0
if timeframe.change('W')
    monday_high := na
    monday_low := na
    monday_open := na
    monday_time := na
if flareMonday and flareNewTradingDay
    monday_time := time
    monday_open := open
    monday_high := high
    monday_low := low
else if flareMonday and not na(monday_high)
    monday_high := math.max(monday_high, high)
    monday_low := math.min(monday_low, low)
// Original FX session inputs use the symbol exchange timezone, as in the source.
f_session(string sess) =>
    inside = timeframe.isintraday and not na(time(timeframe.period,sess))
    newDay = timeframe.change('D')
    var float h = na
    var float l = na
    var float o = na
    var int t = na
    if inside
        if not inside[1] or newDay or na(t)
            h := high
            l := low
            o := open
            t := time
        else
            h := math.max(h,high)
            l := math.min(l,low)
    [h,l,o,t]
[flondonhigh,flondonlow,flondonopen,londontime] = f_session(Londont)
[fushigh,fuslow,fusopen,ustime] = f_session(USt)
[fasiahigh,fasialow,fasiaopen,asiatime] = f_session(Asiat)
linewidthint = linesize == 'Large' ? 3 : linesize == 'Medium' ? 2 : 1
fontsize = labelsize == 'Small' ? size.tiny : labelsize == 'Medium' ? size.normal : size.large
linestyles = linestyle == 'Dashed' ? line.style_dashed : linestyle == 'Dotted' ? line.style_dotted : line.style_solid
get_limit_right(int bars) =>
    time + int(chartSeconds * 1000) * bars

