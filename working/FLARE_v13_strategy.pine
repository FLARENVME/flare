bool smHoldLongEvent = false
bool smHoldShortEvent = false
bool smBreakUpEvent = false
bool smBreakDownEvent = false
float smLongLevel = na
float smShortLevel = na
float smBreakUpLevel = na
float smBreakDownLevel = na
string smLongName = ""
string smShortName = ""
string smBreakUpName = ""
string smBreakDownName = ""
bool wbBullAcceptEvent = false
bool wbSupportHoldEvent = false
bool wbRejectWeakEvent = false
bool wbBearAcceptEvent = false
string wbEventName = ""
float wbEventPrice = na

if nMaj > 0
    for mi = 0 to nMaj - 1
        float smP = array.get(mPrice, mi)
        string smN = array.get(mName, mi)
        int smSlot = array.get(mSlot, mi)
        [e, up] = f_track(smSlot, smP)
        // FLARE v3 CHANGE: HOLD / REJ / BRK / FAIL-BRK (broke beyond, returned inside within v3FailBars)
        if boxV3 and smSlot < 37 and e != 0
            int bd = array.get(v3BrkDir, smSlot)
            bool failBrk = e == -1 and bd != 0 and bar_index - array.get(v3BrkBar, smSlot) <= v3FailBars and (up ? 1 : -1) != bd
            if failBrk
                v3FailBrkEvt := true
                array.set(v3BrkDir, smSlot, 0)
            else if e == -1
                v3BrkEvt := true
                array.set(v3BrkDir, smSlot, up ? 1 : -1)
                array.set(v3BrkBar, smSlot, bar_index)
            else if up
                v3HoldEvt := true
            else
                v3RejEvt := true
            v3EvtName := smN
        bool wbNode = smSlot >= 37 and smSlot <= 66
        if wbNode and e != 0
            wbBullAcceptEvent := wbBullAcceptEvent or (e == -1 and up)
            wbSupportHoldEvent := wbSupportHoldEvent or (e == 1 and up)
            wbRejectWeakEvent := wbRejectWeakEvent or (e == 1 and not up)
            wbBearAcceptEvent := wbBearAcceptEvent or (e == -1 and not up)
            wbEventName := smN
            wbEventPrice := smP
        if showBarMarks and e != 0
            dTopHold := dTopHold or (e == 1 and up)
            dBotHold := dBotHold or (e == 1 and not up)
            dTopBrk  := dTopBrk  or (e == -1 and up)
            dBotBrk  := dBotBrk  or (e == -1 and not up)
        if e == 1 and up and (na(smLongLevel) or math.abs(close - smP) < math.abs(close - smLongLevel))
            smHoldLongEvent := true
            smLongLevel := smP
            smLongName := smN
        if e == 1 and not up and (na(smShortLevel) or math.abs(close - smP) < math.abs(close - smShortLevel))
            smHoldShortEvent := true
            smShortLevel := smP
            smShortName := smN
        if e == -1 and up and (na(smBreakUpLevel) or smP > smBreakUpLevel)
            smBreakUpEvent := true
            smBreakUpLevel := smP
            smBreakUpName := smN
        if e == -1 and not up and (na(smBreakDownLevel) or smP < smBreakDownLevel)
            smBreakDownEvent := true
            smBreakDownLevel := smP
            smBreakDownName := smN

// FLARE v2 CHANGE (indicator-only, see v1): alertcondition(wbAlerts and wbBullAcceptEvent, "Structure boxes: Bull accepted", "Price closed above a top-down structure box level on {{ticker}} {{interval}} at {{close}}.")
// FLARE v2 CHANGE (indicator-only, see v1): alertcondition(wbAlerts and wbSupportHoldEvent, "Structure boxes: Support held", "Price rejected below and closed back above a top-down structure box level on {{ticker}} {{interval}} at {{close}}.")
// FLARE v2 CHANGE (indicator-only, see v1): alertcondition(wbAlerts and wbRejectWeakEvent, "Structure boxes: Rejected / weak", "Price rejected above and closed back below a top-down structure box level on {{ticker}} {{interval}} at {{close}}.")
// FLARE v2 CHANGE (indicator-only, see v1): alertcondition(wbAlerts and wbBearAcceptEvent, "Structure boxes: Bear accepted", "Price closed below a top-down structure box level on {{ticker}} {{interval}} at {{close}}.")
if wbAlerts and (wbBullAcceptEvent or wbSupportHoldEvent or wbRejectWeakEvent or wbBearAcceptEvent)
    string wbEventState = wbBullAcceptEvent ? "BULL ACCEPTED" : wbSupportHoldEvent ? "SUPPORT HELD" : wbRejectWeakEvent ? "REJECTED / WEAK" : "BEAR ACCEPTED"
    alert("NVME STRUCTURE BOX | " + wbEventState + " | " + wbEventName + " " + str.tostring(wbEventPrice, format.mintick) + " | close " + str.tostring(close, format.mintick) + " | " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar_close)

// ──────────────── Structures between adjacent majors ────────────────
var int[] sortIdx = array.new_int()
sortIdx := nMaj > 0 ? array.sort_indices(mPrice, order.ascending) : array.new_int()

f_sPrice(k) =>
    array.get(mPrice, array.get(sortIdx, k))

// FLARE v3 CHANGE: sorted, merged calendar boundaries (structure-box centers, slots ≥ 37, excluded).
f_v3Build() =>
    array.clear(v3P)
    array.clear(v3N)
    array.clear(v3W)
    array.clear(v3D)
    array.clear(v9SlotArr)  // FLARE v9 CHANGE
    if nMaj > 0
        for k = 0 to nMaj - 1
            int ix = array.get(sortIdx, k)
            int slot = array.get(mSlot, ix)
            if slot < 37
                float p = array.get(mPrice, ix)
                int n = array.size(v3P)
                if n > 0 and math.abs(p - array.get(v3P, n - 1)) <= syminfo.mintick * 0.5
                    array.set(v3N, n - 1, array.get(v3N, n - 1) + " / " + array.get(mName, ix))
                    array.set(v3W, n - 1, math.max(array.get(v3W, n - 1), f_v3Weight(slot)))
                    array.set(v3D, n - 1, array.get(v3D, n - 1) and f_v3Dev(slot))
                    if f_v3Weight(slot) > f_v3Weight(array.get(v9SlotArr, n - 1))  // FLARE v9 CHANGE
                        array.set(v9SlotArr, n - 1, slot)
                else
                    array.push(v3P, p)
                    array.push(v3N, array.get(mName, ix))
                    array.push(v3W, f_v3Weight(slot))
                    array.push(v3D, f_v3Dev(slot))
                    array.push(v9SlotArr, slot)  // FLARE v9 CHANGE
    0
// Each interior boundary L with neighbors D < L < U becomes a (D, L, U) triple; the signal engine's
// yellow halves avg(lo,center)..center and center..avg(center,hi) are then exactly (D+L)/2..L and L..(L+U)/2.
f_v3Hierarchy() =>
    array.clear(hierarchyTriples)
    array.clear(hierarchyNames)
    array.clear(hierarchyTiers)
    array.clear(v5HierW)  // FLARE v5 CHANGE
    array.clear(v5HierEst)
    array.clear(v9HierSlot)  // FLARE v9 CHANGE
    f_v3Build()
    int n = array.size(v3P)
    if n >= 3
        for i = 1 to n - 2
            float d = array.get(v3P, i - 1)
            float l = array.get(v3P, i)
            float u = array.get(v3P, i + 1)
            bool devL = array.get(v3D, i)
            bool prov = devL or array.get(v3D, i - 1) or array.get(v3D, i + 1)
            if l - d >= 2 * syminfo.mintick and u - l >= 2 * syminfo.mintick and (v3DevSignals or not devL)
                array.push(hierarchyTriples, d)
                array.push(hierarchyTriples, l)
                array.push(hierarchyTriples, u)
                array.push(hierarchyNames, array.get(v3N, i) + " • w" + str.tostring(array.get(v3W, i)) + (devL ? " • DEVELOPING" : " • established") + (prov ? " • PROVISIONAL box (developing endpoint)" : "") + "\nD: " + array.get(v3N, i - 1) + (array.get(v3D, i - 1) ? " (dev)" : "") + " • U: " + array.get(v3N, i + 1) + (array.get(v3D, i + 1) ? " (dev)" : ""))
                array.push(hierarchyTiers, f_v3Tier(array.get(v3W, i)))
                array.push(v5HierW, array.get(v3W, i))  // FLARE v5 CHANGE
                array.push(v9HierSlot, array.get(v9SlotArr, i))  // FLARE v9 CHANGE
                array.push(v5HierEst, not prov)
    0

int activeK = -1
if nMaj > 1
    for si = 0 to nMaj - 2
        if close >= f_sPrice(si) and close <= f_sPrice(si + 1)
            activeK := si
            break

if showQ and nMaj > 1
    for sj = 0 to nMaj - 2
        loP = f_sPrice(sj)
        hiP = f_sPrice(sj + 1)
        if hiP - loP >= math.avg(loP, hiP) * minGapPc / 100
            [e25, u25] = f_track(NMAJ + sj * 3,     loP + 0.25 * (hiP - loP))
            [e50, u50] = f_track(NMAJ + sj * 3 + 1, loP + 0.50 * (hiP - loP))
            [e75, u75] = f_track(NMAJ + sj * 3 + 2, loP + 0.75 * (hiP - loP))
            if showBarMarks and barMarksQuart
                dTopHold := dTopHold or (e25 == 1 and u25) or (e50 == 1 and u50) or (e75 == 1 and u75)
                dBotHold := dBotHold or (e25 == 1 and not u25) or (e50 == 1 and not u50) or (e75 == 1 and not u75)
                dTopBrk  := dTopBrk  or (e25 == -1 and u25) or (e50 == -1 and u50) or (e75 == -1 and u75)
                dBotBrk  := dBotBrk  or (e25 == -1 and not u25) or (e50 == -1 and not u50) or (e75 == -1 and not u75)


// Focused price-first setup engine. Full source retained separately.
gSignal = "Box reactions • Bull / Bear"
boxSignals = input.bool(true,"Enable box reactions",group=gSignal,tooltip="Requires named box display and Use box levels in signal map. Original wing mode remains drawing-only.")
boxShowBuildup = input.bool(false,"Show optional buildup B",group=gSignal)
boxShowWarnings = input.bool(true,"Show tiny early warnings",group=gSignal)
boxStrict = input.bool(false,"Require prior confirmed local pivot",group=gSignal)
boxPivotBars = input.int(2,"Pivot left/right bars",minval=1,maxval=10,group=gSignal)
boxExpire = input.int(12,"Warning expiry • chart bars",minval=1,maxval=100,group=gSignal)
boxCooldown = input.int(2,"Pause after resolution • bars",minval=0,maxval=50,group=gSignal)
bfLookback = input.int(40,"Box drawing lookback • bars",minval=5,maxval=300,group=gSignal)
bfYellow = input.color(#FFE600,"Yellow reaction halves",group=gSignal)
colBull = input.color(#39FF14,"Bull confirmation",group=gSignal)
colBear = input.color(#FF1493,"Bear confirmation",group=gSignal)
// FLARE v1 CHANGE: optional explicit sweep/reclaim -> warning-candle breakout mode. Default keeps original behavior.
boxV1Mode = input.string("v1 Sweep → warning-candle breakout", "Setup / confirmation mode", options=["Original","v1 Sweep → warning-candle breakout"], group=gSignal,
     tooltip="LEGEND • EARLY L: a closed candle traded below a named box center (blue level) and closed back above it. Warning only, no entry. Its high/low are frozen. • L: a LATER closed candle closes above the frozen warning high = confirmed long, one per setup. • EARLY S / S: exact mirror (sweep above, close back below; confirm on close below frozen warning low). • X: invalidated (trade beyond the frozen sweep extreme), canceled or expired. Invalidation is processed before confirmation on the same candle. Original mode: any sweep, reclaim or edge rejection may warn and confirmation also needs a directional candle body. v1 mode: sweep-and-reclaim only, close beyond frozen warning high/low confirms, a target touched before confirmation expires the setup, and the turn level ignores the pivot option.")
bool boxV1 = boxV1Mode != "Original"

// Exact halves, no exchange-tick rounding in geometry.
f_boxReaction(int direction,float lo,float center,float hi) =>
    float edge = math.avg(center,direction == 1 ? hi : lo)
    float body = math.abs(close-open)
    bool sweep = direction == 1 ? close[1] >= center and low < center and close > center : close[1] <= center and high > center and close < center
    bool reclaim = direction == 1 ? close[1] <= center and close > center and close > open : close[1] >= center and close < center and close < open
    bool reject = direction == 1 ? close[1] > edge and low <= edge and close > center and close > open and (math.min(open,close)-low > body or (low < low[1] and close > close[1])) : close[1] < edge and high >= edge and close < center and close < open and (high-math.max(open,close) > body or (high > high[1] and close < close[1]))
    sweep or reclaim or reject

// FLARE v1 CHANGE: sweep-and-reclaim of the center only (same sweep test as above, isolated).
f_boxSweepOnly(int direction,float center) =>
    direction == 1 ? close[1] >= center and low < center and close > center : close[1] <= center and high > center and close < center

// Last known pivots are published after setup processing; no negative offsets.
boxPH = ta.pivothigh(high,boxPivotBars,boxPivotBars)
boxPL = ta.pivotlow(low,boxPivotBars,boxPivotBars)
var float knownPH = na
var float knownPL = na
var int setupDir = 0
var int hintDir = 0
var int setupBar = na
var int resolvedBar = na
var bool setupConfirmed = false
var float setupLo = na
var float setupHi = na
var float setupCenter = na
var float setupTurn = na
var float setupInvalid = na
var string setupName = ""
var string setupState = "WAIT"
var int setupTime = na  // FLARE v1 CHANGE: frozen creation timestamp
var float buildupCenter = na
bool buildupEvent = false
bool bullEvent = false
bool bearEvent = false
bool earlyEvent = false
bool invalidEvent = false
// ═════════ FLARE v5 CHANGE: independent filter candidates (all default OFF → identical to v4) ═════════
gV5 = "v5 • Filter candidates (default OFF)"
v5UseVwap = input.bool(false, "(a) VWAP side: long only close above session VWAP, short only below", group=gV5,
     tooltip="Session-anchored ta.vwap(hlc3), checked on the confirmed L/S candle. A reclaim (close crossing back above) also satisfies 'close above'.")
v5UseRvol = input.bool(false, "(b) Relative volume on warning candle", group=gV5, inline="rv")
v5RvolMin = input.float(1.5, "≥", minval=0.5, step=0.1, group=gV5, inline="rv")
v5RvolLen = input.int(20, "over bars", minval=5, maxval=200, group=gV5, inline="rv",
     tooltip="Warning-candle volume / SMA(volume, N) of the N PRIOR bars, frozen at EARLY L/S. OHLCV volume is a participation proxy, not order flow.")
v5UseDiv = input.bool(false, "(c) Divergence at the sweep", group=gV5, inline="dv")
v5DivSrc = input.string("RSI", "", options=["RSI","MACD histogram"], group=gV5, inline="dv",
     tooltip="Bull: sweep-candle low < last CONFIRMED pivot low and oscillator at sweep > oscillator at that pivot. Bear mirrored with pivot highs. Uses ta.pivotlow/high with the existing pivot left/right bars; pivots exist only after their right bars close. Frozen at EARLY L/S.")
v5RsiLen = input.int(14, "RSI length", minval=2, group=gV5)
v5UseWeight = input.bool(false, "(d) Boundary filter", group=gV5, inline="wt")
v5MinW = input.int(4, "min weight", minval=1, maxval=7, group=gV5, inline="wt")
v5EstOnly = input.bool(true, "established only", group=gV5, inline="wt",
     tooltip="v3 box mode only. Weight of the frozen boundary L (Yearly 7 … 4H/session 1). Established only = L not developing and box not PROVISIONAL. Ignored in Original box mode.")
v5UseSess = input.bool(false, "(e) Session window (PT)", group=gV5, inline="ss")
v5Sess = input.session("0630-1300", "", group=gV5, inline="ss", tooltip="America/Los_Angeles, checked on the confirmed L/S candle (the order fills next bar open).")
gV5P = "v5 • Prop mode (Lucid Flex 50K baseline)"
v5Prop = input.bool(false, "Prop mode", group=gV5P, tooltip="Baseline from Lucid Trading help center (Oct 2026): $2,000 EOD trailing MLL, trails highest closing balance, locks at $50,100 once balance exceeds $52,100; max 4 minis. Verify current rules with the firm.")
v5StartBal = input.float(50000, "Starting balance", group=gV5P)
v5Mll = input.float(2000, "EOD trailing max loss", group=gV5P)
v5TrailCap = input.float(52100, "Initial trail balance (MLL locks above)", group=gV5P)
v5LockBal = input.float(50100, "Locked MLL balance", group=gV5P)
v5MaxContracts = input.int(4, "Max contracts", minval=1, group=gV5P)
v5UseDll = input.bool(false, "Daily loss stop", group=gV5P, inline="dll")
v5Dll = input.float(1000, "$", minval=50, group=gV5P, inline="dll", tooltip="Realized + open P/L since the trading-day start. When hit: flatten and block new entries until the next trading day.")

// Series used by the filters (computed every bar; values frozen at the warning candle below).
v5Vwap = ta.vwap(hlc3)
v5Rvol = volume / ta.sma(volume, v5RvolLen)[1]
[v5MacdL, v5MacdS, v5MacdH] = ta.macd(close, 12, 26, 9)
v5Osc = v5DivSrc == "RSI" ? ta.rsi(close, v5RsiLen) : v5MacdH
v5PL = ta.pivotlow(low, boxPivotBars, boxPivotBars)
v5PH = ta.pivothigh(high, boxPivotBars, boxPivotBars)
var float v5LastPL = na
var float v5LastPLOsc = na
var float v5LastPH = na
var float v5LastPHOsc = na
var float v5SetupRvol = na
var bool v5SetupBullDiv = false
var bool v5SetupBearDiv = false
var int v5SetupW = na
var bool v5SetupEst = true

// ═════════ FLARE v7 CHANGE: independent toggles. Defaults: (a) ON, (b)-(e) OFF. (f) time window = v5 (e) session input. ═════════
gV7 = "v7 • Regime / confirmation toggles"
v7BeTfGate = input.bool(true, "(a) Breakeven only on chart TF ≥", group=gV7, inline="a")
v7BeMinTf = input.timeframe("15", "", group=gV7, inline="a", tooltip="Below this chart timeframe the v6 +kR breakeven is disabled (3m/5m behave like v4 exits).")
v7UseChop = input.bool(false, "(b) Block fades when CHOP <", group=gV7, inline="b")
v7ChopMin = input.float(40, "", minval=1, maxval=100, group=gV7, inline="b")
v7ChopTf = input.timeframe("15", "on TF", group=gV7, inline="b2")
v7ChopLen = input.int(14, "length", minval=2, group=gV7, inline="b2", tooltip="Choppiness Index = 100·log10(ΣATR(1),n / (highest−lowest,n)) / log10(n), last CLOSED bar of the chosen TF (request with [1] + lookahead_on). Low = trending. If the chosen TF is below the chart TF the chart TF is used.")
v7UseMss = input.bool(true, "(c) Structure-break confirmation", group=gV7, inline="c")
v7PivLen = input.int(3, "pivot len", minval=1, maxval=10, group=gV7, inline="c")
v7MssBars = input.int(12, "within bars", minval=1, maxval=100, group=gV7, inline="c", tooltip="Long: after EARLY L, confirm only on a closed candle closing above max(warning high, most recent confirmed pivot high at the warning). Pivots exist only after their right bars. No confirm within N bars = EXPIRED. Stop stays at the frozen sweep extreme. Short mirrored.")
v7UseStretch = input.bool(false, "(d) VWAP stretch ≥", group=gV7, inline="d")
v7StretchK = input.float(1.0, "σ", minval=0.1, step=0.1, group=gV7, inline="d", tooltip="At the warning close: long fade needs (VWAP − close)/σ ≥ k, short needs (close − VWAP)/σ ≥ k. Session-anchored VWAP and its volume-weighted stdev (ta.vwap with stdev band 1).")
v7UseAtrStop = input.bool(false, "(e) ATR stop buffer", group=gV7, inline="e")
v7AtrK = input.float(0.25, "k·ATR(14)", minval=0.0, step=0.05, group=gV7, inline="e")
v7AtrMax = input.float(1.5, "skip if stop > ×ATR", minval=0.25, step=0.25, group=gV7, inline="e", tooltip="Stop = frozen sweep extreme ∓ k·ATR(14) instead of the tick buffer; skip the trade if |reference − stop| > max×ATR(14). ATR at the signal bar.")

f_v7Chop(int n) =>
    float rng = ta.highest(high, n) - ta.lowest(low, n)
    rng > 0 ? 100 * math.log10(math.sum(ta.atr(1), n) / rng) / math.log10(n) : na
string v7ChopTfEff = timeframe.in_seconds(v7ChopTf) < timeframe.in_seconds() ? timeframe.period : v7ChopTf
float v7Chop = request.security(syminfo.tickerid, v7ChopTfEff, f_v7Chop(v7ChopLen)[1], lookahead=barmerge.lookahead_on)
[v7Vwap, v7VwapUp, v7VwapDn] = ta.vwap(hlc3, session.isfirstbar, 1)
float v7Sd = v7VwapUp - v7Vwap
float v7Atr = ta.atr(14)
v7PH = ta.pivothigh(high, v7PivLen, v7PivLen)
v7PL = ta.pivotlow(low, v7PivLen, v7PivLen)
var float v7LastPH = na
var float v7LastPL = na
var float v7MssLvl = na
var float v7SetupStretch = na
// FLARE v8 CHANGE: v7 AC validation → structure-break default ON, only below a chart-TF cutoff (2h failed in v7 AC).
v8MssBelowMin = input.int(15, "(c) Structure-break on TFs below • minutes", minval=1, maxval=1440, group=gV7, tooltip="Structure-break confirmation applies only when chart timeframe < this many minutes. v7 validation: positive both halves on 3m/5m; 30m 2nd half and 2h failed. Consider 15.")
bool v7Mss = v7UseMss and boxV1 and timeframe.in_seconds() < v8MssBelowMin * 60

// ═════════ FLARE v8 CHANGE: independent toggles, all default OFF (v8 defaults == v7 defaults) ═════════
gV8 = "v8 • Trend veto / exits / entry / guard (default OFF)"
v8VetoRange = input.bool(false, "(1a) Veto fades: today's range >", group=gV8, inline="1a")
v8RangeX = input.float(1.0, "× 20-day avg daily range", minval=0.1, step=0.1, group=gV8, inline="1a", tooltip="Range = trading-day high − low so far (CME trading day). ADR = SMA(high−low, 20) of COMPLETED daily bars ([1] + lookahead_on). Blocks both sides.")
v8VetoVwap = input.bool(false, "(1b) Veto fades: closes on one side of session VWAP for", group=gV8, inline="1b")
v8VwapN = input.int(24, "bars", minval=2, maxval=500, group=gV8, inline="1b", tooltip="Long fade vetoed after N consecutive closes BELOW session VWAP; short after N closes ABOVE.")
v8VetoEma = input.bool(false, "(1c) Veto fades: 1h EMA(50) slope opposes", group=gV8, tooltip="Slope = EMA50[1] − EMA50[4] on CLOSED 1h bars ([1]+lookahead_on); chart TF used if above 1h. Long vetoed if slope < 0, short if > 0.")
v8UseTimeStop = input.bool(false, "(2) Time stop: exit after", group=gV8, inline="2")
v8TimeBars = input.int(12, "bars if never reached +0.5R", minval=1, maxval=500, group=gV8, inline="2")
v8Partial = input.bool(false, "(3) Partial: close half at +1R, rest to breakeven", group=gV8, inline="3")
v8PartQty = input.int(2, "contracts (≥2)", minval=2, maxval=100, group=gV8, inline="3", tooltip="When ON, position size is raised to at least this many contracts (default 2) so half can exit at 1R; compare P/L per contract against 1-contract runs.")
v8Trail = input.string("Off", "(4) Trail after +1R", options=["Off","ATR","Last confirmed swing"], group=gV8, inline="4")
v8TrailK = input.float(1.5, "ATR k", minval=0.1, step=0.1, group=gV8, inline="4", tooltip="Armed when a closed bar reaches +1R. ATR: stop ratchets to close ∓ k·ATR(14). Swing: stop ratchets to the last confirmed pivot low/high (v7 pivot length). Never loosens.")
v8Retr = input.bool(false, "(5) Entry: limit at 50% of confirmation candle", group=gV8, inline="5")
v8RetrBars = input.int(4, "cancel after bars", minval=1, maxval=50, group=gV8, inline="5", tooltip="Limit at (high+low)/2 of the confirmed L/S candle; R:R and TPs measured from that price. Unfilled setups and their would-be market-entry outcome (TP1 vs stop, stop-first on same bar) are counted in the table.")
v8SideGuard = input.bool(false, "(6) Daily side guard: block a side after", group=gV8, inline="6")
v8SideStops = input.int(2, "stop-outs per trading day", minval=1, maxval=10, group=gV8, inline="6")

bool v8NewDay = ta.change(time_tradingday) != 0
var float v8DayHi = na
var float v8DayLo = na
if v8NewDay or na(v8DayHi)
    v8DayHi := high
    v8DayLo := low
else
    v8DayHi := math.max(v8DayHi, high)
    v8DayLo := math.min(v8DayLo, low)
float v8Adr = request.security(syminfo.tickerid, "D", ta.sma(high - low, 20)[1], lookahead=barmerge.lookahead_on)
var int v8AboveRun = 0
var int v8BelowRun = 0
if barstate.isconfirmed and not na(v7Vwap)
    v8AboveRun := close > v7Vwap ? v8AboveRun + 1 : 0
    v8BelowRun := close < v7Vwap ? v8BelowRun + 1 : 0
string v8EmaTf = timeframe.in_seconds("60") < timeframe.in_seconds() ? timeframe.period : "60"
float v8EmaSlope = request.security(syminfo.tickerid, v8EmaTf, ta.ema(close, 50)[1] - ta.ema(close, 50)[4], lookahead=barmerge.lookahead_on)

// ═════════ FLARE v9 CHANGE: level memory, trendline-break trigger, scalp + runner exits (all default OFF) ═════════
gV9 = "v9 • Level memory / trendline / scalp + runner (default OFF)"
v9MemFilter = input.string("Off", "Level memory filter", options=["Off","Last touch was HOLD/REJ (not a break)","Prior holds > breaks","Skip if last touch was BREAK"], group=gV9,
     tooltip="Uses the boundary's held/broken counts and last outcome from the existing per-level tracker, read from the PREVIOUS bar (the sweep candle's own touch is excluded). Counts reset when the level's price changes (new period). v3 box mode only. Offline ES 5m approximation: last=break setups were weak in both halves; see V9_PLAN.md.")
v9Tl = input.bool(false, "Trendline-break confirmation", group=gV9, tooltip="At EARLY L: line through the last two confirmed pivot highs (v7 pivot length) if descending; confirm on a closed candle closing above the line value at that bar. EARLY S mirrored with ascending pivot lows. Falls back to the warning-candle extreme if no valid line. Overrides the structure-break trigger when ON. Offline approximation: weaker than structure-break.")
v9Scalp = input.string("Half-way to next boundary (v3 TP1)", "Scalp TP1 + runner", options=["Off","Fixed R","Half-way to next boundary (v3 TP1)"], group=gV9, inline="sc")
v9ScalpR = input.float(0.5, "R", minval=0.1, maxval=3.0, step=0.05, group=gV9, inline="sc")
v9Runner = input.string("TP2 (next boundary)", "Runner target", options=["TP1","TP2 (next boundary)","TP3"], group=gV9,
     tooltip="When scalp mode is ON: half the contracts (default 2 → 1+1) exit at the scalp level; the runner targets this level and its stop moves to entry + 1 tick after a CLOSED bar reaches the scalp level. Breakeven TP1 hit rates (ES, ~6-8 pt stops, $2.50/side + 1 tick): 0.3R ≈ 81%, 0.5R ≈ 71%, 0.75R ≈ 61%, 1R ≈ 53%.")
v9Qty = input.int(2, "Contracts when scalp mode ON", minval=2, maxval=100, group=gV9)
// Previous-bar copies of per-slot memory so the setup reads history BEFORE the sweep touch.
var int[] v9PrevHeld = array.new_int(NMAJ, 0)
var int[] v9PrevBroke = array.new_int(NMAJ, 0)
var int[] v9PrevLast = array.new_int(NMAJ, 0)
var int v9SetupSlot = na
var int v9SetupHeld = 0
var int v9SetupBroke = 0
var int v9SetupLast = 0
var float v9TlB1 = na
var float v9TlV1 = na
var float v9TlB2 = na
var float v9TlV2 = na
var float v9PH1 = na
var int v9PH1Bar = na
var float v9PH2 = na
var int v9PH2Bar = na
var float v9PL1 = na
var int v9PL1Bar = na
var float v9PL2 = na
var int v9PL2Bar = na
f_v9LastTxt(int st) =>
    st == 2 ? "BULL BRK" : st == 1 ? "HOLD" : st == -1 ? "REJ" : st == -2 ? "BEAR BRK" : "none"
f_v9MemOK(int held, int broke, int last) =>
    v9MemFilter == "Off" or not boxV3 ? true : v9MemFilter == "Last touch was HOLD/REJ (not a break)" ? (last == 1 or last == -1) : v9MemFilter == "Skip if last touch was BREAK" ? math.abs(last) != 2 : held > broke  // FLARE v10 CHANGE: 'not BREAK' option (no-touch history passes)

// ═════════ FLARE v10 CHANGE: candle tags + optional confirm close-location filter (default OFF) ═════════
gV10 = "v10 • Candle tags / close-location filter (default OFF)"
v10UseCl = input.bool(false, "Confirm candle close-location filter", group=gV10, inline="cl")
v10ClPct = input.float(25, "top/bottom %", minval=1, maxval=100, step=1, group=gV10, inline="cl",
     tooltip="Longs: confirm candle (the closed bar that triggers the order) must close in the top X% of its range; shorts: bottom X%. Zero-range bars fail. Offline ES 5m: weak (PF ≈1.02-1.05 per half with last=HOLD), not supported on NQ. See IDEAS_v10.md.")
v10MinHeld = input.float(50, "Min level held %", minval=0, maxval=100, step=5, group=gV10,
     tooltip="0 = off. Requires holds/(holds+breaks) x 100 >= this value from the level tracker, read from the bar before the sweep. A level with no prior touches passes. v3 box mode only. TV v9 C: >=60% looked strong on 3m but did NOT hold on 5m; see VALIDATION_v9.md.")
f_v10HeldPct(int held, int broke) =>
    held + broke > 0 ? 100.0 * held / (held + broke) : na
var float v10SwWick = na
var bool v10SwEng = false
f_v10ClLoc(int dir) =>
    float rng = high - low
    rng <= 0 ? na : 100.0 * (dir == 1 ? close - low : high - close) / rng

// FLARE v3 CHANGE: box construction switch
if boxV3
    f_v3Hierarchy()
else
    f_hierarchy()
if boxSignals and wbShow and wbInherited and wbUseSignals and barstate.isconfirmed
    if setupDir != 0
        // Numeric geometry is frozen. Deeper live display halves cannot move this setup.
        bool invalid = setupDir == 1 ? low < setupInvalid : high > setupInvalid
        bool target = setupDir == 1 ? high >= setupHi : low <= setupLo
        bool expired = bar_index-setupBar > (v7Mss and not setupConfirmed ? v7MssBars : boxExpire)  // FLARE v7 CHANGE
        bool namedExists = false
        bool sameParent = false
        if array.size(hierarchyNames) > 0
            for i = 0 to array.size(hierarchyNames)-1
                if array.get(hierarchyNames,i) == setupName
                    namedExists := true
                    sameParent := math.abs(array.get(hierarchyTriples,i*3)-setupLo) < syminfo.mintick*0.001 and math.abs(array.get(hierarchyTriples,i*3+2)-setupHi) < syminfo.mintick*0.001
        bool changed = not namedExists or not sameParent
        if invalid or target or expired or changed
            // FLARE v1 CHANGE: in v1 mode an unconfirmed setup reaching its target is an expiry, not a resolution.
            bool v1Missed = boxV1 and target and not setupConfirmed and not invalid
            setupState := invalid ? "INVALID • reaction wick" : v1Missed ? "EXPIRED • target before confirmation" : target ? "RESOLVED • next boundary" : expired ? "EXPIRED" : "CANCELED • box changed"
            invalidEvent := invalid or changed or (expired and not setupConfirmed) or v1Missed
            setupDir := 0
            buildupCenter := na
            resolvedBar := bar_index
        else if not setupConfirmed and bar_index > setupBar
            // FLARE v1 CHANGE: v1 confirms on a close beyond the frozen warning high/low only.
            // FLARE v7 CHANGE: (c) structure-break level replaces warning extreme when enabled
            // FLARE v9 CHANGE: trendline-break trigger (frozen line) takes precedence when ON
            float v9TlNow = na(v9TlB1) or v9TlB2 == v9TlB1 ? na : v9TlV2 + (v9TlV2 - v9TlV1) / (v9TlB2 - v9TlB1) * (bar_index - v9TlB2)
            float v9TlLvl = na(v9TlNow) ? setupTurn : v9TlNow
            bool turned = v9Tl and boxV1 ? (setupDir == 1 ? close > v9TlLvl : close < v9TlLvl) : v7Mss ? (setupDir == 1 ? close > v7MssLvl : close < v7MssLvl) : boxV1 ? (setupDir == 1 ? close > setupTurn : close < setupTurn) : setupDir == 1 ? close > setupTurn and close > open : close < setupTurn and close < open
            if turned
                setupConfirmed := true
                bullEvent := setupDir == 1
                bearEvent := setupDir == -1
                setupState := setupDir == 1 ? "CONFIRMED BULL" : "CONFIRMED BEAR"
    else if na(resolvedBar) or bar_index-resolvedBar > boxCooldown
        float nearest = na
        int candidate = -1
        int candidateDir = 0
        bool sawBull = false
        bool sawBear = false
        float buildCenter = na
        float buildDistance = na
        if array.size(hierarchyNames) > 0
            for i = 0 to array.size(hierarchyNames)-1
                float lo = array.get(hierarchyTriples,i*3)
                float center = array.get(hierarchyTriples,i*3+1)
                float hi = array.get(hierarchyTriples,i*3+2)
                // FLARE v1 CHANGE: v1 uses sweep-only trigger and the warning candle extreme as turn.
                float longTurn = boxStrict and not boxV1 ? knownPH : high
                float shortTurn = boxStrict and not boxV1 ? knownPL : low
                bool longReact = boxV1 ? (f_boxSweepOnly(1,center) or (boxV3 and f_boxSweepOnly(1,math.avg(lo,center)))) : f_boxReaction(1,lo,center,hi)  // FLARE v3 CHANGE: boundary or half-area edge
                bool shortReact = boxV1 ? (f_boxSweepOnly(-1,center) or (boxV3 and f_boxSweepOnly(-1,math.avg(center,hi)))) : f_boxReaction(-1,lo,center,hi)  // FLARE v3 CHANGE
                bool longOK = longReact and high < hi and not na(longTurn) and close <= longTurn and longTurn < hi
                bool shortOK = shortReact and low > lo and not na(shortTurn) and close >= shortTurn and shortTurn > lo
                sawBull := sawBull or longOK
                sawBear := sawBear or shortOK
                float distance = math.abs(close-center)
                bool inYellow = close >= math.avg(lo,center) and close <= math.avg(center,hi)
                bool compression = high-low <= high[1]-low[1] and high[1]-low[1] <= high[2]-low[2]
                bool failedPush = (low < low[1] and close > close[1]) or (high > high[1] and close < close[1])
                if inYellow and (compression or failedPush) and (na(buildDistance) or distance < buildDistance)
                    buildCenter := center
                    buildDistance := distance
                if (longOK or shortOK) and (na(nearest) or distance < nearest)
                    nearest := distance
                    candidate := i
                    candidateDir := longOK ? 1 : -1
            if na(buildCenter)
                buildupCenter := na
            else if na(buildupCenter) or math.abs(buildCenter-buildupCenter) >= syminfo.mintick*0.001
                buildupCenter := buildCenter
                buildupEvent := true
            if sawBull and sawBear
                setupState := "WAIT • two-sided reactions"
            else if candidate >= 0
                setupDir := candidateDir
                hintDir := candidateDir
                setupBar := bar_index
                setupConfirmed := false
                setupLo := array.get(hierarchyTriples,candidate*3)
                setupCenter := array.get(hierarchyTriples,candidate*3+1)
                setupHi := array.get(hierarchyTriples,candidate*3+2)
                setupName := array.get(hierarchyNames,candidate)
                setupTurn := boxStrict and not boxV1 ? (setupDir == 1 ? knownPH : knownPL) : (setupDir == 1 ? high : low)
                setupTime := time  // FLARE v1 CHANGE
                // FLARE v5 CHANGE: freeze filter inputs at the warning candle (pivots are prior confirmed ones only).
                v5SetupRvol := v5Rvol
                v5SetupBullDiv := not na(v5LastPL) and low < v5LastPL and v5Osc > v5LastPLOsc
                v5SetupBearDiv := not na(v5LastPH) and high > v5LastPH and v5Osc < v5LastPHOsc
                v5SetupW := boxV3 and candidate < array.size(v5HierW) ? array.get(v5HierW, candidate) : na
                v5SetupEst := boxV3 and candidate < array.size(v5HierEst) ? array.get(v5HierEst, candidate) : true
                // FLARE v7 CHANGE: freeze MSS level and VWAP stretch at the warning
                // FLARE v9 CHANGE: freeze level memory (previous bar) and trendline pivots
                v9SetupSlot := boxV3 and candidate < array.size(v9HierSlot) ? array.get(v9HierSlot, candidate) : na
                v9SetupHeld := na(v9SetupSlot) ? 0 : array.get(v9PrevHeld, v9SetupSlot)
                v9SetupBroke := na(v9SetupSlot) ? 0 : array.get(v9PrevBroke, v9SetupSlot)
                v9SetupLast := na(v9SetupSlot) ? 0 : array.get(v9PrevLast, v9SetupSlot)
                // FLARE v10 CHANGE: freeze sweep-candle tags (tracking only)
                v10SwWick := high - low <= 0 ? na : (setupDir == 1 ? math.min(open, close) - low : high - math.max(open, close)) / (high - low)
                v10SwEng := setupDir == 1 ? (close > open and close[1] < open[1] and close >= open[1] and open <= close[1]) : (close < open and close[1] > open[1] and close <= open[1] and open >= close[1])
                bool tlOK = setupDir == 1 ? (not na(v9PH1) and not na(v9PH2) and v9PH2 < v9PH1) : (not na(v9PL1) and not na(v9PL2) and v9PL2 > v9PL1)
                v9TlB1 := tlOK ? (setupDir == 1 ? v9PH1Bar : v9PL1Bar) : na
                v9TlV1 := tlOK ? (setupDir == 1 ? v9PH1 : v9PL1) : na
                v9TlB2 := tlOK ? (setupDir == 1 ? v9PH2Bar : v9PL2Bar) : na
                v9TlV2 := tlOK ? (setupDir == 1 ? v9PH2 : v9PL2) : na
                v7MssLvl := setupDir == 1 ? (na(v7LastPH) ? high : math.max(high, v7LastPH)) : (na(v7LastPL) ? low : math.min(low, v7LastPL))
                v7SetupStretch := v7Sd > 0 ? (setupDir == 1 ? (v7Vwap - close) / v7Sd : (close - v7Vwap) / v7Sd) : na
                setupInvalid := setupDir == 1 ? low : high
                buildupCenter := na
                buildupEvent := false
                earlyEvent := true
                setupState := setupDir == 1 ? "EARLY BULL" : "EARLY BEAR"
    if not na(boxPH)
        knownPH := boxPH
    if not na(v5PL)  // FLARE v5 CHANGE
        v5LastPL := v5PL
        v5LastPLOsc := v5Osc[boxPivotBars]
    if not na(v5PH)
        v5LastPH := v5PH
        v5LastPHOsc := v5Osc[boxPivotBars]
    if not na(boxPL)
        knownPL := boxPL

// FLARE v7 CHANGE: publish confirmed pivots after setup processing (used from the next bar).
if not na(v7PH)
    v7LastPH := v7PH
    v9PH1 := v9PH2  // FLARE v9 CHANGE: keep last two confirmed pivots with bar indices
    v9PH1Bar := v9PH2Bar
    v9PH2 := v7PH
    v9PH2Bar := bar_index - v7PivLen
if not na(v7PL)
    v9PL1 := v9PL2
    v9PL1Bar := v9PL2Bar
    v9PL2 := v7PL
    v9PL2Bar := bar_index - v7PivLen
// FLARE v9 CHANGE: snapshot per-slot memory for the next bar
for si = 0 to NMAJ - 1
    array.set(v9PrevHeld, si, array.get(stHeld, si))
    array.set(v9PrevBroke, si, array.get(stBroke, si))
    array.set(v9PrevLast, si, array.get(stLastState, si))
if not na(v7PL)
    v7LastPL := v7PL

string signalHint = setupName+"\n"+setupState+"\nTurn: directional CLOSE "+(hintDir == 1 ? "above " : "below ")+str.tostring(setupTurn,format.mintick)+"\nInvalid: trade beyond "+str.tostring(setupInvalid,format.mintick)+"\nMode: "+boxV1Mode+(na(setupTime) ? "" : "\nWarning: "+str.format_time(setupTime,"yyyy-MM-dd HH:mm",syminfo.timezone))+(boxV3 and not na(v9SetupSlot) ? "\nLevel memory (before sweep): held " + str.tostring(v9SetupHeld) + " / broken " + str.tostring(v9SetupBroke) +  " • last " + f_v9LastTxt(v9SetupLast) + " • held " + (v9SetupHeld + v9SetupBroke > 0 ? str.tostring(100.0 * v9SetupHeld / (v9SetupHeld + v9SetupBroke), "#") + "%" : "n/a") : "")+(v12Bias == "Off" ? "" : "\nHTF bias (" + v12Tf + "): " + f_v12Txt(v12BiasNow))+"\nFrozen on warning candle. Confirmation is a local box reaction, not a guaranteed trend reversal."
f_auxMarker(boxShowBuildup and buildupEvent,close,"B",label.style_none,yloc.price,color.new(bfYellow,90),bfYellow,"BUILDUP: close inside a yellow half-zone with three nonexpanding ranges or a failed push. Warning only; no entry.")
f_auxMarker(boxShowWarnings and earlyEvent,setupDir == 1 ? low : high,setupDir == 1 ? "EARLY L" : "EARLY S",label.style_none,setupDir == 1 ? yloc.belowbar : yloc.abovebar,color.new(bfYellow,90),bfYellow,signalHint)
f_auxMarker(bullEvent or bearEvent,bullEvent ? low : high,bullEvent ? "L" : "S",label.style_none,bullEvent ? yloc.belowbar : yloc.abovebar,color.new(colBull,90),bullEvent ? colBull : colBear,signalHint)
f_auxMarker(boxShowWarnings and invalidEvent,close,"X",label.style_none,yloc.price,color.new(colBear,90),color.silver,signalHint)
// FLARE v2 CHANGE (indicator-only, see v1): alertcondition(buildupEvent,"Box: BUILDUP","Compression or failed push inside a named yellow area on {{ticker}} {{interval}}. Warning only.")
// FLARE v2 CHANGE (indicator-only, see v1): alertcondition(bullEvent,"Box: CONFIRMED BULL","Confirmed bullish box reaction on {{ticker}} {{interval}} at {{close}}.")
// FLARE v2 CHANGE (indicator-only, see v1): alertcondition(bearEvent,"Box: CONFIRMED BEAR","Confirmed bearish box reaction on {{ticker}} {{interval}} at {{close}}.")
// FLARE v2 CHANGE (indicator-only, see v1): alertcondition(earlyEvent,"Box: EARLY WARNING","Unconfirmed box reaction on {{ticker}} {{interval}}. Inspect frozen turn and invalidation.")
// FLARE v2 CHANGE (indicator-only, see v1): alertcondition(invalidEvent,"Box: INVALIDATED","Box reaction canceled on {{ticker}} {{interval}}. Inspect its boundary and age.")
// FLARE v1 CHANGE: directional two-stage alerts. Events are only set inside the barstate.isconfirmed block, so they fire on closed bars.
// FLARE v2 CHANGE (indicator-only, see v1): alertcondition(earlyEvent and setupDir == 1,"Pre-Alert Long","EARLY L (pre-alert, no entry) on {{ticker}} {{interval}} at {{close}}. Confirm = later close above frozen warning high.")
// FLARE v2 CHANGE (indicator-only, see v1): alertcondition(earlyEvent and setupDir == -1,"Pre-Alert Short","EARLY S (pre-alert, no entry) on {{ticker}} {{interval}} at {{close}}. Confirm = later close below frozen warning low.")
// FLARE v2 CHANGE (indicator-only, see v1): alertcondition(bullEvent,"Confirmed Long","L confirmed long on closed candle, {{ticker}} {{interval}} at {{close}}.")
// FLARE v2 CHANGE (indicator-only, see v1): alertcondition(bearEvent,"Confirmed Short","S confirmed short on closed candle, {{ticker}} {{interval}} at {{close}}.")
// FLARE v3 CHANGE: progression, failed-to-reach, state markers (closed bars only, never backdated).
f_v3Box() =>
    float dB = na
    float uB = na
    string dName = ""
    string uName = ""
    int n = array.size(v3P)
    if n > 0
        for i = 0 to n - 1
            float p = array.get(v3P, i)
            if p <= close
                dB := p
                dName := array.get(v3N, i)
            else if na(uB)
                uB := p
                uName := array.get(v3N, i)
    [dB, uB, dName, uName]
[v3Dn, v3Up, v3DnName, v3UpName] = f_v3Box()
var float v3UpT = na
var float v3DnT = na
var int v3UpPush = 0
var int v3DnPush = 0
bool v3NrUp = false
bool v3NrDn = false
if boxV3 and barstate.isconfirmed
    if na(v3UpT) or na(v3Up) or math.abs(v3Up - v3UpT) > syminfo.mintick * 0.5
        v3UpT := v3Up
        v3UpPush := 0
    if na(v3DnT) or na(v3Dn) or math.abs(v3Dn - v3DnT) > syminfo.mintick * 0.5
        v3DnT := v3Dn
        v3DnPush := 0
    if not na(v3UpT) and high >= v3UpT
        v3UpPush := 0
    else if not na(v3UpT) and not na(v3Dn) and not na(boxPH) and boxPH < v3UpT and boxPH >= v3Dn + (v3UpT - v3Dn) * v3PushPct / 100
        v3UpPush += 1
        v3NrUp := v3UpPush >= v3FailN
    if not na(v3DnT) and low <= v3DnT
        v3DnPush := 0
    else if not na(v3DnT) and not na(v3Up) and not na(boxPL) and boxPL > v3DnT and boxPL <= v3Up - (v3Up - v3Dn) * v3PushPct / 100
        v3DnPush += 1
        v3NrDn := v3DnPush >= v3FailN
string v3Prog = na(v3Up) or na(v3Dn) ? "" : close >= math.avg(v3Dn, v3Up) ? "Approaching " + v3UpName + " • inside its lower half-area" : "Approaching " + v3DnName + " • inside its upper half-area"
f_auxMarker(boxV3 and v3ShowStates and v3HoldEvt, low, "HOLD", label.style_none, yloc.belowbar, color.new(colBull,95), color.new(colBull,30), "HOLD: wicked through " + v3EvtName + " and closed back above.")
f_auxMarker(boxV3 and v3ShowStates and v3RejEvt, high, "REJ", label.style_none, yloc.abovebar, color.new(colBear,95), color.new(colBear,30), "REJ: wicked through " + v3EvtName + " and closed back below.")
f_auxMarker(boxV3 and v3ShowStates and v3BrkEvt, close, "BRK", label.style_none, yloc.price, color.new(#00BFFF,95), color.new(#00BFFF,30), "BRK: closed through " + v3EvtName + ".")
f_auxMarker(boxV3 and v3ShowStates and v3FailBrkEvt, close, "FAIL-BRK", label.style_none, yloc.price, color.new(bfYellow,95), bfYellow, "FAIL-BRK: broke " + v3EvtName + " then closed back inside within " + str.tostring(v3FailBars) + " bars.")
f_auxMarker(boxV3 and v3ShowNR and v3NrUp, high, "NR" + str.tostring(v3UpPush), label.style_none, yloc.abovebar, color.new(color.silver,95), color.silver, "Failed to reach " + v3UpName + ": " + str.tostring(v3UpPush) + " confirmed pivot highs stalled below it. Not a touch; no reversal assumed.")
f_auxMarker(boxV3 and v3ShowNR and v3NrDn, low, "NR" + str.tostring(v3DnPush), label.style_none, yloc.belowbar, color.new(color.silver,95), color.silver, "Failed to reach " + v3DnName + ": " + str.tostring(v3DnPush) + " confirmed pivot lows stalled above it. Not a touch; no reversal assumed.")

// Spaceman renderer: original source anchors, Standard / Right Anchored, merge.
var array<line> levelLines = array.new<line>()
var array<label> levelLabels = array.new<label>()
var array<box> weeklyNestedBoxes = array.new<box>()
var array<line> weeklyNestedCenters = array.new<line>()
// Active structure-box handle is retained inside f_renderSpaceman.
f_structureBoxText(string tfCode, string wing, int number, float boundaryA, float boundaryB) =>
    int positionPct = f_boxPosition(boundaryA, boundaryB)
    string location = positionPct < 0 ? "PRICE BELOW" : positionPct > 100 ? "PRICE ABOVE" : "PRICE " + str.tostring(positionPct) + "%"
    tfCode + " " + wing + " BOX " + str.tostring(number) + " • " + location

f_drawStructureWing(string tfCode, bool upperWing, float periodOpen, float priorExtreme, int leftTime, int rightTime, color tfColor, int fillDim) =>
    if not na(periodOpen) and not na(priorExtreme) and not na(leftTime)
        [center1, center2, center3] = f_nestedCenters(periodOpen, priorExtreme)
        string wing = upperWing ? "HIGH" : "LOW"
        string wingStyle = upperWing ? line.style_solid : line.style_dashed
        string wingAlign = upperWing ? text.align_top : text.align_bottom
        for i = 0 to 2
            float boundaryA = i == 0 ? periodOpen : center1
            float boundaryB = i == 2 ? center2 : priorExtreme
            int fill = i == 0 ? fillDim : math.max(0, fillDim - i)
            int border = i == 2 ? wbBorderDim : math.min(100, wbBorderDim + (2 - i) * 10)
            string caption = wbShowBoxText ? f_structureBoxText(tfCode, wing, i + 1, boundaryA, boundaryB) : ""
            array.push(weeklyNestedBoxes, box.new(left = leftTime, top = math.max(boundaryA, boundaryB), right = rightTime, bottom = math.min(boundaryA, boundaryB),
                 xloc = xloc.bar_time, border_color = color.new(tfColor, border), border_width = i == 2 ? 2 : 1, border_style = wingStyle,
                 bgcolor = color.new(tfColor, fill), text = caption,
                 text_color = color.new(tfColor, wbTextDim), text_size = size.tiny, text_halign = text.align_right,
                 text_valign = i == 2 ? text.align_center : wingAlign, force_overlay = true))
        if wbShowCenters
            for i = 0 to 2
                float center = i == 0 ? center1 : i == 1 ? center2 : center3
                int dim = i == 2 ? wbCenterDim : math.min(100, wbCenterDim + (2 - i) * 10)
                array.push(weeklyNestedCenters, line.new(leftTime, center, rightTime, center, xloc = xloc.bar_time,
                     color = color.new(tfColor, dim), width = i == 0 ? 1 : 2, style = i == 2 ? line.style_dotted : wingStyle, force_overlay = true))
    0

boxViewAtr = ta.atr(14)
f_drawNamedBoxes() =>
    array<color> colors = array.from(YearlyColor,quarterlyColor,MonthlyColor,WeeklyColor,DailyColor,MondayColor)
    array<float> scores = array.new<float>()
    int count = array.size(hierarchyNames)
    bool smallChart = chartSeconds <= 900
    if count > 0
        for k = 0 to count-1
            float lo = array.get(hierarchyTriples,k*3)
            float hi = array.get(hierarchyTriples,k*3+2)
            float center = array.get(hierarchyTriples,k*3+1)
            // Interval proximity first; among containing boxes, prefer the nearer center.
            float gap = math.max(math.max(lo-close,close-hi),0.0)
            array.push(scores,gap+math.abs(close-center)*0.01+(hi-lo)*0.0001)
        for k = 0 to count-1
            float lo = array.get(hierarchyTriples,k*3)
            float center = array.get(hierarchyTriples,k*3+1)
            float hi = array.get(hierarchyTriples,k*3+2)
            float gap = math.max(math.max(lo-close,close-hi),0.0)
            int rank = 0
            for j = 0 to count-1
                if array.get(scores,j) < array.get(scores,k) or (array.get(scores,j) == array.get(scores,k) and j < k)
                    rank += 1
            int tier = array.get(hierarchyTiers,k)
            bool mainRange = not str.contains(array.get(hierarchyNames,k)," · half ")
            bool visible = not wbAutoView or (smallChart ? rank < wbNearCount and gap <= math.max(nz(boxViewAtr),syminfo.mintick)*wbNearAtr : (tier == 2 or tier == 3) and mainRange)
            if visible
                int left = time-int(chartSeconds*1000)*(bfLookback+(array.size(hierarchyNames)-k-1)*8)
                int right = get_limit_right(distanceright)
                color identity = array.get(colors,array.get(hierarchyTiers,k))
                array.push(weeklyNestedBoxes,box.new(left,hi,right,lo,xloc=xloc.bar_time,border_color=color.new(identity,wbBorderDim),bgcolor=color.new(identity,99),text=wbShowBoxText ? array.get(hierarchyNames,k) : "",text_size=size.tiny,text_color=color.new(identity,wbTextDim),force_overlay=true))
                // Yellow halves around center: [(lo+center)/2,center] and [center,(center+hi)/2].
                if wbShowLower
                    array.push(weeklyNestedBoxes,box.new(left,center,right,math.avg(lo,center),xloc=xloc.bar_time,border_color=color.new(bfYellow,92),bgcolor=color.new(bfYellow,wbYellowDim),force_overlay=true))
                if wbShowUpper
                    array.push(weeklyNestedBoxes,box.new(left,math.avg(center,hi),right,center,xloc=xloc.bar_time,border_color=color.new(bfYellow,92),bgcolor=color.new(bfYellow,wbYellowDim),force_overlay=true))
                if wbShowCenters
                    array.push(weeklyNestedCenters,line.new(left,center,right,center,xloc=xloc.bar_time,color=color.new(#00BFFF,wbCenterDim),force_overlay=true))
    0

// FLARE v3 CHANGE: nearest adjacent boxes only; dim fills; developing endpoints dashed and tagged.
f_v3DrawBoxes() =>
    array<color> colors = array.from(YearlyColor,quarterlyColor,MonthlyColor,WeeklyColor,DailyColor,MondayColor)
    int n = array.size(v3P)
    if n >= 2
        int b = -1
        for i = 0 to n - 1
            if array.get(v3P, i) <= close
                b := i
        bool smallChart = chartSeconds <= 900
        int nearN = smallChart ? v3NearSmall : v3NearLarge
        int i0 = math.max(0, b - nearN + 1)
        int i1 = math.min(n - 1, math.max(b, 0) + nearN)
        int left = time - int(chartSeconds * 1000) * bfLookback
        int right = get_limit_right(distanceright)
        if i1 > i0
            for i = i0 to i1 - 1
                float dP = array.get(v3P, i)
                float uP = array.get(v3P, i + 1)
                int wMax = math.max(array.get(v3W, i), array.get(v3W, i + 1))
                bool prov = array.get(v3D, i) or array.get(v3D, i + 1)
                bool emph = smallChart or wMax >= v3LargeMinW
                color identity = prov ? color.gray : array.get(colors, f_v3Tier(wMax))
                string cap = wbShowBoxText ? array.get(v3N, i) + " → " + array.get(v3N, i + 1) + (prov ? " • PROVISIONAL" : "") : ""
                array.push(weeklyNestedBoxes, box.new(left, uP, right, dP, xloc=xloc.bar_time, border_color=color.new(identity, emph ? wbBorderDim : 95), border_style=prov ? line.style_dashed : line.style_solid, bgcolor=color.new(identity, 99), text=cap, text_size=size.tiny, text_color=color.new(identity, emph ? wbTextDim : 85), text_halign=text.align_right, force_overlay=true))
            for j = i0 to i1
                float lP = array.get(v3P, j)
                bool emphL = smallChart or array.get(v3W, j) >= v3LargeMinW
                int dim = emphL ? wbYellowDim : math.min(100, wbYellowDim + 2)
                color yb = array.get(v3D, j) ? color.gray : bfYellow
                if wbShowLower and j > 0
                    array.push(weeklyNestedBoxes, box.new(left, lP, right, math.avg(array.get(v3P, j - 1), lP), xloc=xloc.bar_time, border_color=color.new(yb, 94), bgcolor=color.new(yb, dim), force_overlay=true))
                if wbShowUpper and j < n - 1
                    array.push(weeklyNestedBoxes, box.new(left, math.avg(lP, array.get(v3P, j + 1)), right, lP, xloc=xloc.bar_time, border_color=color.new(yb, 94), bgcolor=color.new(yb, dim), force_overlay=true))
    0

f_draw(float p,int start,string txt,color c,int width) =>
    int right = get_limit_right(distanceright)
    int left = displayStyle == 'Right Anchored' ? get_limit_right(radistance) : start
    array.push(levelLines,line.new(left,p,right,p,xloc=xloc.bar_time,color=c,width=width,style=linestyles,force_overlay=true))
    array.push(levelLabels,label.new(right,p,txt+' '+str.tostring(p,format.mintick),xloc=xloc.bar_time,style=label.style_none,textcolor=c,size=fontsize,force_overlay=true))
f_renderSpaceman() =>
    var box structureBox = na
    if barstate.islast
        for l in levelLines
            line.delete(l)
        for l in levelLabels
            label.delete(l)
        for b in weeklyNestedBoxes
            box.delete(b)
        for l in weeklyNestedCenters
            line.delete(l)
        array.clear(levelLines)
        array.clear(levelLabels)
        array.clear(weeklyNestedBoxes)
        array.clear(weeklyNestedCenters)
        if wbShow and boxV3  // FLARE v3 CHANGE
            f_v3DrawBoxes()
        if wbShow and not boxV3 and (wbInherited or wbAutoView)
            f_drawNamedBoxes()
        if wbShow and not boxV3 and not wbInherited and not wbAutoView
            int wbRight = get_limit_right(distanceright)
            if wbShowYear
                if wbShowUpper
                    f_drawStructureWing("YEAR", true, yearly_open, prevyear_high, yearly_time, wbRight, YearlyColor, wbYearFillDim)
                if wbShowLower
                    f_drawStructureWing("YEAR", false, yearly_open, prevyear_low, yearly_time, wbRight, YearlyColor, wbYearFillDim)
            if wbShowQuarter
                if wbShowUpper
                    f_drawStructureWing("QUARTER", true, quarterly_open, quarterlyh_open, quarterly_time, wbRight, quarterlyColor, wbQuarterFillDim)
                if wbShowLower
                    f_drawStructureWing("QUARTER", false, quarterly_open, quarterlyl_open, quarterly_time, wbRight, quarterlyColor, wbQuarterFillDim)
            if wbShowMonth
                if wbShowUpper
                    f_drawStructureWing("MONTH", true, monthly_open, monthlyh_open, monthly_time, wbRight, MonthlyColor, wbMonthFillDim)
                if wbShowLower
                    f_drawStructureWing("MONTH", false, monthly_open, monthlyl_open, monthly_time, wbRight, MonthlyColor, wbMonthFillDim)
            if wbShowWeek
                if wbShowUpper
                    f_drawStructureWing("WEEK", true, weekly_open, weeklyh_open, weekly_time, wbRight, WeeklyColor, wbWeekFillDim)
                if wbShowLower
                    f_drawStructureWing("WEEK", false, weekly_open, weeklyl_open, weekly_time, wbRight, WeeklyColor, wbWeekFillDim)
            if wbShowDay
                if wbShowUpper
                    f_drawStructureWing("DAY", true, daily_open, dailyh_open, daily_time, wbRight, DailyColor, wbDayFillDim)
                if wbShowLower
                    f_drawStructureWing("DAY", false, daily_open, dailyl_open, daily_time, wbRight, DailyColor, wbDayFillDim)
        if nMaj > 0
            int k = 0
            while k < nMaj
                int ix = array.get(sortIdx,k)
                float p = array.get(mPrice,ix)
                string txt = array.get(mName,ix)
                int left = array.get(mTime,ix)
                color c = array.get(mColor,ix)
                int next = k+1
                while mergebool and next < nMaj and (not wbAutoView or (array.get(mSlot,ix) < 37 and array.get(mSlot,array.get(sortIdx,next)) < 37)) and math.abs(f_sPrice(next)-p) <= syminfo.mintick*0.5
                    int other = array.get(sortIdx,next)
                    txt += ' / '+array.get(mName,other)
                    left := math.min(left,array.get(mTime,other))
                    next += 1
                // Automatic mode draws box centers only through the filtered named-box renderer.
                if not wbAutoView or array.get(mSlot,ix) < 37
                    f_draw(p,left,txt+(boxV3 and f_v3Dev(array.get(mSlot,ix)) ? " · DEV" : "")+f_statsTxt(array.get(mSlot,ix)),boxV3 and f_v3Dev(array.get(mSlot,ix)) ? color.new(c,55) : c,linewidthint)  // FLARE v3 CHANGE: developing tag
                k := next
        if showQ and nMaj > 1
            if qMode == 'Nearest above + below'
                float nearestBelow = na
                float nearestAbove = na
                int nearestBelowPct = na
                int nearestAbovePct = na
                int nearestBelowSlot = na
                int nearestAboveSlot = na
                for i = 0 to nMaj-2
                    float lo = f_sPrice(i)
                    float hi = f_sPrice(i+1)
                    if (not wbAutoView or (array.get(mSlot,array.get(sortIdx,i)) < 37 and array.get(mSlot,array.get(sortIdx,i+1)) < 37)) and hi-lo >= math.abs(math.avg(lo,hi))*minGapPc/100
                        for j = 0 to 2
                            float p = lo+(0.25+0.25*j)*(hi-lo)
                            int pct = 25+25*j
                            int slot = NMAJ+i*3+j
                            if p <= close and (na(nearestBelow) or p > nearestBelow)
                                nearestBelow := p
                                nearestBelowPct := pct
                                nearestBelowSlot := slot
                            if p > close and (na(nearestAbove) or p < nearestAbove)
                                nearestAbove := p
                                nearestAbovePct := pct
                                nearestAboveSlot := slot
                float maxFollowDistance = math.abs(close) * qMaxDistancePc / 100
                int followLeft = time - int(chartSeconds * 1000) * qFollowBars
                if not na(nearestBelow) and close-nearestBelow <= maxFollowDistance
                    f_draw(nearestBelow,followLeft,str.tostring(nearestBelowPct)+'% BELOW'+f_statsTxt(nearestBelowSlot),colActive,1)
                if not na(nearestAbove) and nearestAbove-close <= maxFollowDistance
                    f_draw(nearestAbove,followLeft,str.tostring(nearestAbovePct)+'% ABOVE'+f_statsTxt(nearestAboveSlot),colActive,1)
            else
                for i = 0 to nMaj-2
                    float lo = f_sPrice(i)
                    float hi = f_sPrice(i+1)
                    if (not wbAutoView or (array.get(mSlot,array.get(sortIdx,i)) < 37 and array.get(mSlot,array.get(sortIdx,i+1)) < 37)) and hi-lo >= math.abs(math.avg(lo,hi))*minGapPc/100 and (qMode == 'All structures' or i == activeK)
                        int anchor = math.min(array.get(mTime,array.get(sortIdx,i)),array.get(mTime,array.get(sortIdx,i+1)))
                        for j = 0 to 2
                            float p = lo+(0.25+0.25*j)*(hi-lo)
                            f_draw(p,anchor,str.tostring(25+25*j)+'%'+f_statsTxt(NMAJ+i*3+j),i == activeK ? colActive : colDorm,1)
        if showZone and activeK >= 0
            float top = f_sPrice(activeK+1)
            float bot = f_sPrice(activeK)
            if na(structureBox)
                structureBox := box.new(time,top,get_limit_right(distanceright),bot,xloc=xloc.bar_time,border_color=color.new(colActive,80),bgcolor=colZone,extend=extend.left,force_overlay=true)
            else
                box.set_lefttop(structureBox,time,top)
                box.set_rightbottom(structureBox,get_limit_right(distanceright),bot)
        else if not na(structureBox)
            box.delete(structureBox)
            structureBox := na

    0

f_renderSpaceman()


var label statusLabel = na
if barstate.islast
    if not na(statusLabel)
        label.delete(statusLabel)
    if boxSignals and wbShow and wbInherited and wbUseSignals
        statusLabel := label.new(bar_index+2,close,setupState+(boxV3 and v3Prog != "" ? "\n"+v3Prog : ""),style=label.style_label_left,size=size.tiny,textcolor=setupDir == 1 ? colBull : setupDir == -1 ? colBear : color.silver,color=color.new(color.black,80),tooltip=signalHint,force_overlay=true)

plotshape(showBarMarks and dTopHold,title="Upper map hold",style=shape.circle,location=location.abovebar,color=#FF1493,size=size.tiny)
plotshape(showBarMarks and dBotHold,title="Lower map hold",style=shape.circle,location=location.belowbar,color=#39FF14,size=size.tiny)
plotshape(showBarMarks and dTopBrk,title="Upper map break",style=shape.circle,location=location.abovebar,color=#00BFFF,size=size.tiny)
plotshape(showBarMarks and dBotBrk,title="Lower map break",style=shape.circle,location=location.belowbar,color=#00BFFF,size=size.tiny)


// ═════════════ FLARE v2 CHANGE: strategy layer (entries / structural exits) ═════════════
gV2 = "v2 Strategy • entries / exits"
v2Enable = input.bool(true, "Trade confirmed L / S", group=gV2)
v2EntryMode = input.string("Market next open", "Entry mode", options=["Market next open","Retest limit at reclaimed level"], group=gV2,
     tooltip="Market: order sent on the confirmed L/S close, fills at the next bar open. Retest: limit at the frozen box center (the reclaimed level), valid N bars, canceled if the frozen stop trades first.")
v2RetestBars = input.int(6, "Retest limit valid • bars", minval=1, maxval=50, group=gV2)
v2StopTicks = input.int(2, "Stop buffer beyond frozen sweep extreme • ticks", minval=0, maxval=50, group=gV2)
v2Opp = input.string("Reverse", "Opposite confirmed signal", options=["Reverse","Close only","Ignore"], group=gV2)
v2Qty = input.int(1, "Contracts", minval=1, maxval=100, group=gV2)
int v2QtyEff = v5Prop ? math.min(v2Qty, v5MaxContracts) : v2Qty  // FLARE v5 CHANGE: prop contract cap
v2QtyEff := v8Partial ? math.max(v2QtyEff, v8PartQty) : v2QtyEff  // FLARE v8 CHANGE (3)
bool v9ScalpOn = v9Scalp != "Off"  // FLARE v9 CHANGE
v2QtyEff := v9ScalpOn ? math.max(v2QtyEff, v9Qty) : v2QtyEff
v2Single = input.string("TP1", "Target when 1 contract", options=["TP1","TP2","TP3"], group=gV2)
v2Tp1Pct = input.int(50, "TP1 share % (2+ contracts)", minval=0, maxval=100, group=gV2)
v2Tp2Pct = input.int(25, "TP2 share % (rest goes to TP3)", minval=0, maxval=100, group=gV2)
v2BE = input.bool(true, "Move stop to entry after a CLOSED bar touched TP1", group=gV2)
// FLARE v6 CHANGE: single rule change. Move stop to entry + offset once a CLOSED bar has reached +k R (R = |fill - frozen stop|).
v6UseBeR = input.bool(true, "Breakeven after +k R (closed bar)", group=gV2, inline="ber",
     tooltip="v4 trade lists: 16-36% of stopped trades had reached ≥1R open profit first, on every timeframe and both halves. Checked on bar close; the moved stop works from the next bar. Off = v5/v4 behavior.")
v6BeR = input.float(1.0, "k", minval=0.25, maxval=3.0, step=0.25, group=gV2, inline="ber")
v6BeTicks = input.int(1, "offset ticks", minval=0, maxval=20, group=gV2, inline="ber")
v2MinTpTicks = input.int(4, "Minimum target distance • ticks", minval=1, maxval=200, group=gV2)
v2ShowLevels = input.bool(true, "Draw frozen stop / TP lines", group=gV2)
// FLARE v4 CHANGE: single rule change. Skip setups whose room to the traded target is smaller than the frozen risk.
v4MinRR = input.float(1.0, "Minimum reward:risk to traded target (0 = off, v3 behavior)", minval=0.0, maxval=5.0, step=0.25, group=gV2,
     tooltip="Reward = |target - reference|, risk = |reference - frozen stop|, reference = signal close (market) or reclaimed level (retest). Target = TP1 for 1 contract unless 'Target when 1 contract' says otherwise; TP1 for split exits. v3 trade lists: TP1 ≈ 7 pts on every timeframe while stops grew to 9-15 pts on 15m-2h.")

// Nearest candidate strictly beyond ref in direction dir, at least minD away.
f_v2Next(array<float> arr, int dir, float ref, float minD) =>
    float best = na
    if not na(ref)
        for p in arr
            if not na(p) and (dir == 1 ? p >= ref + minD : p <= ref - minD) and (na(best) or math.abs(p - ref) < math.abs(best - ref))
                best := p
    best

// FLARE v3 CHANGE: v3 ladder. TP1 = nearest half-area edge (midpoint between adjacent boundaries),
// TP2 = next adjacent boundary beyond TP1, TP3 = the one after. Original box mode keeps the v2 ladder.
f_v2Ladder(int dir, float ref) =>
    float minD = v2MinTpTicks * syminfo.mintick
    float t1 = na
    float t2 = na
    float t3 = na
    if boxV3
        array<float> mids = array.new_float()
        int n = array.size(v3P)
        if n >= 2
            for i = 0 to n - 2
                array.push(mids, math.avg(array.get(v3P, i), array.get(v3P, i + 1)))
        t1 := f_v2Next(mids, dir, ref, minD)
        t2 := f_v2Next(v3P, dir, t1, syminfo.mintick)
        t3 := f_v2Next(v3P, dir, t2, syminfo.mintick)
    else
        array<float> yel = array.new_float()
        array<float> allLv = array.new_float()
        int n = array.size(hierarchyNames)
        if n > 0
            for i = 0 to n - 1
                float lo = array.get(hierarchyTriples, i*3)
                float c = array.get(hierarchyTriples, i*3+1)
                float hi = array.get(hierarchyTriples, i*3+2)
                array.push(yel, math.avg(lo, c))
                array.push(yel, c)
                array.push(yel, math.avg(c, hi))
                array.push(allLv, lo)
                array.push(allLv, hi)
                array.push(allLv, c)
                array.push(allLv, math.avg(lo, c))
                array.push(allLv, math.avg(c, hi))
        for p in mPrice
            array.push(allLv, p)
        t1 := f_v2Next(yel, dir, ref, minD)
        t2 := f_v2Next(allLv, dir, t1, syminfo.mintick)
        t3 := f_v2Next(allLv, dir, t2, syminfo.mintick)
    t2 := na(t2) ? t1 : t2
    t3 := na(t3) ? t2 : t3
    [t1, t2, t3]

var int v2Dir = 0
var bool v2Pending = false
var int v2OrderBar = na
var float v2Ref = na
var float v2Stop = na
var float v2Tp1 = na
var float v2Tp2 = na
var float v2Tp3 = na
var bool v2Tp1Hit = false
var bool v6BeHit = false  // FLARE v6 CHANGE
var float v6BePx = na
var int v2Skipped = 0
var int v2Ambig = 0
var array<line> v2Lines = array.new<line>()

// FLARE v5 CHANGE: prop mode tracking on closed-trade balance at end of each trading day.
var float v5MaxEod = na
var float v5Floor = na
var bool v5Breached = false
var string v5BreachDate = ""
var float v5WorstRoom = na
var float v5DayStart = 0.0
var bool v5Blocked = false
bool v5NewDay = ta.change(time_tradingday) != 0
if v5NewDay and not barstate.isfirst
    float eodBal = v5StartBal + strategy.netprofit[1]
    v5MaxEod := na(v5MaxEod) ? math.max(eodBal, v5StartBal) : math.max(v5MaxEod, eodBal)
    v5Floor := v5MaxEod > v5TrailCap ? v5LockBal : v5MaxEod - v5Mll
    float room = eodBal - v5Floor
    v5WorstRoom := na(v5WorstRoom) ? room : math.min(v5WorstRoom, room)
    if eodBal <= v5Floor and not v5Breached
        v5Breached := true
        v5BreachDate := str.format_time(time[1], "yyyy-MM-dd", "America/Los_Angeles")
    v5DayStart := strategy.netprofit[1]
    v5Blocked := false
if v5Prop and v5UseDll and barstate.isconfirmed and not v5Blocked
    if strategy.netprofit + strategy.openprofit - v5DayStart <= -v5Dll
        strategy.cancel_all()
        strategy.close_all(comment="daily loss stop")
        v5Blocked := true
        v2Pending := false
        v2Dir := 0

// FLARE v8 CHANGE: state for exits / retrace shadow / side guard
var int v8FillBar = na
var float v8MaxFav = 0.0
var bool v8PartHit = false
var bool v8TrailArmed = false
var float v8TrailPx = na
var int v8Unfilled = 0
var int v8ShWin = 0
var int v8ShLoss = 0
var int v8ShOpen = 0
var float v8ShEntry = na
var int v8ShRes = 0
var bool v8ShTrack = false
var bool v8ShCount = false
var int v8ShDir = 0
var float v8ShStop = na
var float v8ShTp = na
var int v8ShStart = na
var int v8LongStops = 0
var int v8ShortStops = 0
var int v8Seen = 0
var int v8LastEntryBar = na
var int v8GuardBlocks = 0
if v8NewDay
    v8LongStops := 0
    v8ShortStops := 0
if strategy.closedtrades > v8Seen
    for i = v8Seen to strategy.closedtrades - 1
        int eb = strategy.closedtrades.entry_bar_index(i)
        if strategy.closedtrades.profit(i) < 0 and str.contains(strategy.closedtrades.exit_comment(i), "stop") and eb != v8LastEntryBar
            v8LastEntryBar := eb
            if strategy.closedtrades.size(i) > 0
                v8LongStops += 1
            else
                v8ShortStops += 1
    v8Seen := strategy.closedtrades
f_v8Tight(int dir, float a, float b) =>
    na(b) ? a : na(a) ? b : dir == 1 ? math.max(a, b) : math.min(a, b)
// Would-be market-entry shadow for retrace orders (stop first on same bar).
if v8ShTrack and barstate.isconfirmed and bar_index > v8ShStart
    if na(v8ShEntry)
        v8ShEntry := open
    if v8ShRes == 0
        bool shStop = v8ShDir == 1 ? low <= v8ShStop : high >= v8ShStop
        bool shTp = v8ShDir == 1 ? high >= v8ShTp : low <= v8ShTp
        v8ShRes := shStop ? -1 : shTp ? 1 : 0
    if v8ShRes != 0
        if v8ShCount
            v8ShWin += v8ShRes == 1 ? 1 : 0
            v8ShLoss += v8ShRes == -1 ? 1 : 0
            v8ShOpen -= 1
            v8ShCount := false
        v8ShTrack := v8ShCount

int v2Sig = bullEvent ? 1 : bearEvent ? -1 : 0
string v2Id = v2Dir == 1 ? "L" : "S"

// 1) Housekeeping on the closed bar, before new orders: pending fill, retest expiry, flat reset, TP1 touch, ambiguity audit.
if v2Dir != 0
    if v2Pending and strategy.position_size * v2Dir > 0
        v2Pending := false
        v8ShTrack := v8ShCount  // FLARE v8 CHANGE: filled → drop this order's shadow
    if v2Pending and (v2EntryMode != "Market next open" or v8Retr) and strategy.position_size == 0
        bool stopFirst = v2Dir == 1 ? low <= v2Stop : high >= v2Stop
        if bar_index - v2OrderBar >= (v8Retr ? v8RetrBars : v2RetestBars) or stopFirst
            strategy.cancel(v2Id)
            v2Pending := false
            v2Dir := 0
            if v8Retr  // FLARE v8 CHANGE (5): unfilled retrace; book its shadow outcome
                v8Unfilled += 1
                if v8ShRes != 0
                    v8ShWin += v8ShRes == 1 ? 1 : 0
                    v8ShLoss += v8ShRes == -1 ? 1 : 0
                    v8ShTrack := false
                else
                    v8ShCount := true
                    v8ShOpen += 1
    if v8Retr and v2Pending and strategy.position_size * v2Dir > 0
        v8ShTrack := false
    if v2Dir != 0 and not v2Pending and strategy.position_size == 0 and bar_index > v2OrderBar
        v2Dir := 0
    if v2Dir != 0 and strategy.position_size * v2Dir > 0
        if v2Dir == 1 ? high >= v2Tp1 : low <= v2Tp1
            v2Tp1Hit := true
        // FLARE v6 CHANGE: +k R reached on a closed bar → breakeven stop from next bar.
        float v6Fill = strategy.position_avg_price
        float v6R = math.abs(v6Fill - v2Stop)
        if v6UseBeR and (not v7BeTfGate or timeframe.in_seconds() >= timeframe.in_seconds(v7BeMinTf)) and not v6BeHit and v6R > 0 and (v2Dir == 1 ? high >= v6Fill + v6BeR * v6R : low <= v6Fill - v6BeR * v6R)
            v6BeHit := true
            v6BePx := v6Fill + v2Dir * v6BeTicks * syminfo.mintick
        // FLARE v8 CHANGE: time stop, partial flag, trail (all from frozen reference / stop, closed bars)
        float v8R = math.abs(v2Ref - v2Stop)
        if na(v8FillBar)
            v8FillBar := bar_index
        float v8Fav = v2Dir == 1 ? high - v2Ref : v2Ref - low
        v8MaxFav := math.max(v8MaxFav, v8Fav)
        float v9ScDist = v9Scalp == "Fixed R" ? v9ScalpR * v8R : math.abs(v2Tp1 - v2Ref)  // FLARE v9 CHANGE
        if v9ScalpOn and v8R > 0 and v8MaxFav >= v9ScDist
            v8PartHit := true
        if v8Partial and v8R > 0 and v8MaxFav >= v8R
            v8PartHit := true
        if v8Trail != "Off" and v8R > 0 and v8MaxFav >= v8R
            v8TrailArmed := true
        if v8TrailArmed
            float cand = v8Trail == "ATR" ? close - v2Dir * v8TrailK * v7Atr : (v2Dir == 1 ? v7LastPL : v7LastPH)
            if not na(cand) and (v2Dir == 1 ? cand < close : cand > close)
                v8TrailPx := f_v8Tight(v2Dir, v8TrailPx, cand)
        if v8UseTimeStop and bar_index - v8FillBar >= v8TimeBars and v8MaxFav < 0.5 * v8R
            strategy.close(v2Id, comment="time stop")
        // Same-bar stop + target: emulator picks by open proximity, we assume stop first; count bars where it matters.
        bool both = v2Dir == 1 ? low <= v2Stop and high >= v2Tp1 : high >= v2Stop and low <= v2Tp1
        if both
            v2Ambig += 1

// 2) New confirmed signal (bullEvent / bearEvent only exist on confirmed bars).
if v2Enable and v2Sig != 0
    float pos = strategy.position_size
    bool opp = (pos > 0 and v2Sig == -1) or (pos < 0 and v2Sig == 1) or (v2Pending and v2Dir == -v2Sig)
    bool idle = pos == 0 and not v2Pending
    if opp and v2Opp == "Close only"
        strategy.cancel_all()
        strategy.close_all(comment="opposite signal")
        v2Pending := false
        v2Dir := 0
    if idle or (opp and v2Opp == "Reverse")
        float ref = v8Retr ? hl2 : v2EntryMode == "Market next open" ? close : setupCenter  // FLARE v8 CHANGE (5)
        float v7Buf = v7UseAtrStop ? v7AtrK * v7Atr : v2StopTicks * syminfo.mintick  // FLARE v7 CHANGE (e)
        float stp = v2Sig == 1 ? setupInvalid - v7Buf : setupInvalid + v7Buf
        [t1, t2, t3] = f_v2Ladder(v2Sig, ref)
        bool ok = not na(t1) and not na(stp) and (v2Sig == 1 ? stp < ref : stp > ref)
        // FLARE v4 CHANGE: reward:risk filter, all values frozen at signal time.
        float v4Tgt = v2QtyEff == 1 ? (v2Single == "TP1" ? t1 : v2Single == "TP2" ? t2 : t3) : t1
        float v4RR = na(stp) or na(v4Tgt) or stp == ref ? na : math.abs(v4Tgt - ref) / math.abs(ref - stp)
        ok := ok and (v4MinRR <= 0 or (not na(v4RR) and v4RR >= v4MinRR))
        string v4Cmt = (v2Sig == 1 ? "L" : "S") + " | " + str.replace_all(setupName, "\n", " | ") + " | RR " + str.tostring(v4RR, "#.##")  // FLARE v8 CHANGE: restore fields lost to a misplaced v6 comment
        // FLARE v5 CHANGE: optional filters, each independent; all off = v4.
        bool v5InSess = not na(time(timeframe.period, v5Sess, "America/Los_Angeles"))
        ok := ok and (not v5UseVwap or (v2Sig == 1 ? close > v5Vwap : close < v5Vwap))
        ok := ok and (not v5UseRvol or (not na(v5SetupRvol) and v5SetupRvol >= v5RvolMin))
        ok := ok and (not v5UseDiv or (v2Sig == 1 ? v5SetupBullDiv : v5SetupBearDiv))
        ok := ok and (not v5UseWeight or not boxV3 or (not na(v5SetupW) and v5SetupW >= v5MinW and (not v5EstOnly or v5SetupEst)))
        ok := ok and (not v5UseSess or v5InSess)
        ok := ok and not v5Blocked
        // FLARE v7 CHANGE: (b) chop, (d) stretch, (e) max stop distance
        ok := ok and (not v7UseChop or (not na(v7Chop) and v7Chop >= v7ChopMin))
        ok := ok and (not v7UseStretch or (not na(v7SetupStretch) and v7SetupStretch >= v7StretchK))
        ok := ok and (not v7UseAtrStop or math.abs(ref - stp) <= v7AtrMax * v7Atr)
        // FLARE v8 CHANGE: (1) trend-day regime veto, (6) daily side guard
        bool v8Trend = (v8VetoRange and not na(v8Adr) and v8DayHi - v8DayLo > v8RangeX * v8Adr) or (v8VetoVwap and (v2Sig == 1 ? v8BelowRun >= v8VwapN : v8AboveRun >= v8VwapN)) or (v8VetoEma and not na(v8EmaSlope) and (v2Sig == 1 ? v8EmaSlope < 0 : v8EmaSlope > 0))
        bool v8Guard = v8SideGuard and (v2Sig == 1 ? v8LongStops >= v8SideStops : v8ShortStops >= v8SideStops)
        v8GuardBlocks += ok and v8Guard ? 1 : 0
        ok := ok and not v8Trend and not v8Guard
        ok := ok and f_v9MemOK(v9SetupHeld, v9SetupBroke, v9SetupLast)  // FLARE v9 CHANGE
        ok := ok and (v12Bias == "Off" or v12BiasNow != -v2Sig)  // FLARE v12 CHANGE: HTF bias (block against-bias only)
        ok := ok and (not v13TrendSkip or na(v13MtdTr) or v13MtdTr < v13TrendTh)  // FLARE v13 CHANGE: skip strong trend month
        float v10Cl = f_v10ClLoc(v2Sig)  // FLARE v10 CHANGE
        float v10Hp = f_v10HeldPct(v9SetupHeld, v9SetupBroke)
        ok := ok and (v10MinHeld <= 0 or not boxV3 or na(v10Hp) or v10Hp >= v10MinHeld)
        ok := ok and (not v10UseCl or (not na(v10Cl) and v10Cl >= 100 - v10ClPct))
        v4Cmt := v4Cmt + (boxV3 ? " | mem H" + str.tostring(v9SetupHeld) + " B" + str.tostring(v9SetupBroke) +  " last " + f_v9LastTxt(v9SetupLast) + " h%" + (na(v10Hp) ? "na" : str.tostring(v10Hp, "#")) : "") + (v5UseRvol ? " | RVOL " + str.tostring(v5SetupRvol, "#.##") : "")
        v4Cmt := v4Cmt + " | cl" + (na(v10Cl) ? "na" : str.tostring(v10Cl, "#")) + " wk" + (na(v10SwWick) ? "na" : str.tostring(v10SwWick, "#.##")) + (v10SwEng ? " ENG" : "") + (v12Bias == "Off" ? "" : " | htf " + f_v12Txt(v12BiasNow))  // FLARE v10/v12 CHANGE
        v4Cmt := str.length(v4Cmt) > 240 ? str.substring(v4Cmt, 0, 240) : v4Cmt  // FLARE v10 CHANGE: keep comment length safe
        if ok
            if v2Pending
                strategy.cancel(v2Id)
            v2Dir := v2Sig
            v2Id := v2Sig == 1 ? "L" : "S"
            v2Ref := ref
            v2Stop := stp
            v2Tp1 := t1
            v2Tp2 := t2
            v2Tp3 := t3
            v2Tp1Hit := false
            v6BeHit := false  // FLARE v6 CHANGE
            v6BePx := na
            v8FillBar := na  // FLARE v8 CHANGE
            v8MaxFav := 0.0
            v8PartHit := false
            v8TrailArmed := false
            v8TrailPx := na
            if v8Retr and not v8ShCount
                v8ShTrack := true
                v8ShRes := 0
                v8ShEntry := na
                v8ShDir := v2Sig
                v8ShStop := stp
                v8ShTp := t1
                v8ShStart := bar_index
            v2Pending := true
            v2OrderBar := bar_index
            if v2EntryMode == "Market next open" and not v8Retr
                strategy.entry(v2Id, v2Sig == 1 ? strategy.long : strategy.short, qty=v2QtyEff, comment=v4Cmt)
            else
                strategy.entry(v2Id, v2Sig == 1 ? strategy.long : strategy.short, qty=v2QtyEff, limit=ref, comment=v4Cmt+(v8Retr ? " | retrace50" : " | retest"))
            if v2ShowLevels
                if array.size(v2Lines) > 100
                    for k = 0 to 3
                        line.delete(array.shift(v2Lines))
                array.push(v2Lines, line.new(bar_index, stp, bar_index+12, stp, color=color.new(#FF1493,20), style=line.style_dashed, force_overlay=true))
                array.push(v2Lines, line.new(bar_index, t1, bar_index+12, t1, color=color.new(#39FF14,20), style=line.style_dotted, force_overlay=true))
                array.push(v2Lines, line.new(bar_index, t2, bar_index+12, t2, color=color.new(#39FF14,40), style=line.style_dotted, force_overlay=true))
                array.push(v2Lines, line.new(bar_index, t3, bar_index+12, t3, color=color.new(#39FF14,60), style=line.style_dotted, force_overlay=true))
        else
            v2Skipped += 1

// 3) Frozen bracket exits, re-issued each bar (same ids update in place). Stop moves to entry only after a closed bar touched TP1.
if v2Dir != 0
    float beStop = v2BE and v2Tp1Hit and strategy.position_size != 0 ? strategy.position_avg_price : v2Stop
    float v6Stop1 = v6BeHit ? v6BePx : v2Stop  // FLARE v6 CHANGE
    beStop := v6BeHit ? (v2Dir == 1 ? math.max(beStop, v6BePx) : math.min(beStop, v6BePx)) : beStop
    // FLARE v8 CHANGE: partial-BE and trail tighten stops (never loosen)
    float v8BePx = v2Ref + v2Dir * syminfo.mintick
    v6Stop1 := f_v8Tight(v2Dir, v6Stop1, v8PartHit ? v8BePx : na)
    v6Stop1 := f_v8Tight(v2Dir, v6Stop1, v8TrailPx)
    beStop := f_v8Tight(v2Dir, beStop, v8PartHit ? v8BePx : na)
    beStop := f_v8Tight(v2Dir, beStop, v8TrailPx)
    string v8LossCmt = not na(v8TrailPx) ? "trail" : v8PartHit or v6BeHit ? "BE" : "stop"
    if v9ScalpOn and v2QtyEff >= 2  // FLARE v9 CHANGE: scalp TP1 + runner
        int sh = int(v2QtyEff / 2)
        float scPx = v9Scalp == "Fixed R" ? v2Ref + v2Dir * v9ScalpR * math.abs(v2Ref - v2Stop) : v2Tp1
        float runPx = v9Runner == "TP1" ? v2Tp1 : v9Runner == "TP3" ? v2Tp3 : v2Tp2
        strategy.exit(v2Id+"-SC", v2Id, qty=sh, limit=scPx, stop=v6Stop1, comment_loss=v8LossCmt, comment_profit="scalp")
        strategy.exit(v2Id+"-RN", v2Id, qty=v2QtyEff - sh, limit=runPx, stop=v6Stop1, comment_loss=v8LossCmt, comment_profit="runner")
    else if v8Partial and v2QtyEff >= 2
        int ph = int(v2QtyEff / 2)
        float tgtP = v2Single == "TP1" ? v2Tp1 : v2Single == "TP2" ? v2Tp2 : v2Tp3
        strategy.exit(v2Id+"-P1", v2Id, qty=ph, limit=v2Ref + v2Dir * math.abs(v2Ref - v2Stop), stop=v6Stop1, comment_loss=v8LossCmt, comment_profit="1R")
        strategy.exit(v2Id+"-X", v2Id, qty=v2QtyEff - ph, limit=tgtP, stop=v2Single == "TP1" ? v6Stop1 : beStop, comment_loss=v8LossCmt, comment_profit=v2Single)
    else if v2QtyEff == 1
        float tgt = v2Single == "TP1" ? v2Tp1 : v2Single == "TP2" ? v2Tp2 : v2Tp3
        strategy.exit(v2Id+"-X", v2Id, limit=tgt, stop=v2Single == "TP1" ? v6Stop1 : beStop, comment_loss=v8LossCmt, comment_profit=v2Single)
    else
        int q1 = math.min(v2QtyEff, int(math.round(v2QtyEff * v2Tp1Pct / 100.0)))
        int q2 = math.min(v2QtyEff - q1, int(math.round(v2QtyEff * v2Tp2Pct / 100.0)))
        int q3 = v2QtyEff - q1 - q2
        if q1 > 0
            strategy.exit(v2Id+"-TP1", v2Id, qty=q1, limit=v2Tp1, stop=v6Stop1, comment_loss=v6BeHit ? "BE" : "stop", comment_profit="TP1")
        if q2 > 0
            strategy.exit(v2Id+"-TP2", v2Id, qty=q2, limit=v2Tp2, stop=beStop, comment_loss="stop/BE", comment_profit="TP2")
        if q3 > 0
            strategy.exit(v2Id+"-TP3", v2Id, qty=q3, limit=v2Tp3, stop=beStop, comment_loss="stop/BE", comment_profit="TP3")

// ═════════ FLARE v13 CHANGE: maximum holding time (default 5 h; 0 = off) ═════════
v13MaxHold = input.float(5, "Max hold (hours)", minval=0, maxval=168, step=0.5, group="v13 • Max hold",
     tooltip="Closes any open position at market (next bar open, comment TIME) once the bar close is ≥ this many hours after the first entry fill. Wall-clock hours, including overnight/weekend gaps. 0 = off. Offline v11 CSV check: 5h cap cut 3m net about in half (long-held winners), see HOLD_TIME.md.")
if v13MaxHold > 0 and strategy.position_size != 0 and strategy.opentrades > 0
    if time_close - strategy.opentrades.entry_time(0) >= v13MaxHold * 3600000
        strategy.close_all(comment="TIME")

if barstate.islast
    var table v2Tbl = table.new(position.bottom_right, 1, 10, bgcolor=color.new(color.black,80), force_overlay=true)
    table.cell(v2Tbl, 0, 0, "FLARE v12 • simulated Strategy Tester", text_color=color.silver, text_size=size.tiny)
    if v12Bias != "Off"
        table.cell(v2Tbl, 0, 9, "HTF bias " + v12Tf + ": " + f_v12Txt(v12BiasNow) + " • " + v12Bias, text_color=v12BiasNow == 1 ? color.lime : v12BiasNow == -1 ? color.red : color.silver, text_size=size.tiny)
    table.cell(v2Tbl, 0, 1, "Skipped (no TP / bad stop / RR filter): "+str.tostring(v2Skipped), text_color=color.silver, text_size=size.tiny)
    table.cell(v2Tbl, 0, 2, "Bars with stop+TP1 both touched: "+str.tostring(v2Ambig), text_color=color.yellow, text_size=size.tiny)
    // FLARE v8 CHANGE: retrace / guard summary
    if v8Retr
        table.cell(v2Tbl, 0, 7, "Retrace50 unfilled: " + str.tostring(v8Unfilled) + " • would-be W/L/open " + str.tostring(v8ShWin) + "/" + str.tostring(v8ShLoss) + "/" + str.tostring(v8ShOpen), text_color=color.silver, text_size=size.tiny)
    if v8SideGuard
        table.cell(v2Tbl, 0, 8, "Side-guard blocks: " + str.tostring(v8GuardBlocks), text_color=color.silver, text_size=size.tiny)
    // FLARE v5 CHANGE: prop mode summary (closed-trade EOD equity)
    if v5Prop
        table.cell(v2Tbl, 0, 3, "PROP • EOD trailing MLL " + (v5Breached ? "BREACHED " + v5BreachDate : "never breached"), text_color=v5Breached ? color.red : color.lime, text_size=size.tiny)
        table.cell(v2Tbl, 0, 4, "Current MLL floor: " + str.tostring(v5Floor, "#.##") + (v5MaxEod > v5TrailCap ? " (locked)" : " (trailing)"), text_color=color.silver, text_size=size.tiny)
        table.cell(v2Tbl, 0, 5, "Worst EOD room above floor: " + str.tostring(v5WorstRoom, "#.##"), text_color=color.silver, text_size=size.tiny)
        table.cell(v2Tbl, 0, 6, "Volume filters use OHLCV volume (proxy, not order flow)", text_color=color.gray, text_size=size.tiny)
