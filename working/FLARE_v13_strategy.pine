wbTextDim = input.int(65, "Box text dimmer • higher = dimmer", minval = 0, maxval = 100, group = gWB)

// Top-down box geometry. Every timeframe uses the same three-stage nesting.
// The weekly upper wing retains the original slot IDs so saved statistics and
// alerts remain compatible with the previous version.
f_nestedCenters(float periodOpen, float priorExtreme) =>
    float center1 = math.round_to_mintick(math.avg(periodOpen, priorExtreme))
    float center2 = math.round_to_mintick(math.avg(center1, priorExtreme))
    float center3 = math.round_to_mintick(math.avg(center1, center2))
    [center1, center2, center3]

[wbBox1Center, wbBox2Center, wbBox3Center] = f_nestedCenters(weekly_open, weeklyh_open)
[ybUpper1, ybUpper2, ybUpper3] = f_nestedCenters(yearly_open, prevyear_high)
[ybLower1, ybLower2, ybLower3] = f_nestedCenters(yearly_open, prevyear_low)
[qbUpper1, qbUpper2, qbUpper3] = f_nestedCenters(quarterly_open, quarterlyh_open)
[qbLower1, qbLower2, qbLower3] = f_nestedCenters(quarterly_open, quarterlyl_open)
[mbUpper1, mbUpper2, mbUpper3] = f_nestedCenters(monthly_open, monthlyh_open)
[mbLower1, mbLower2, mbLower3] = f_nestedCenters(monthly_open, monthlyl_open)
[wbLower1, wbLower2, wbLower3] = f_nestedCenters(weekly_open, weeklyl_open)
[dbUpper1, dbUpper2, dbUpper3] = f_nestedCenters(daily_open, dailyh_open)
[dbLower1, dbLower2, dbLower3] = f_nestedCenters(daily_open, dailyl_open)
string wbBox1CenterText = GlobalTextType ? "WB1-M" : "Weekly Box 1 Center"
string wbBox2CenterText = GlobalTextType ? "WB2-M" : "Weekly Box 2 Center"
string wbBox3CenterText = GlobalTextType ? "WB3-M" : "Weekly Box 3 Center"

// Named ranges from the demonstrated method. Price never changes their boundary identities.
var array<float> hierarchyTriples = array.new<float>()
var array<string> hierarchyNames = array.new<string>()
var array<int> hierarchyTiers = array.new<int>()
f_namedBox(string name, int tier, float boundaryA, float boundaryB) =>
    if not na(boundaryA) and not na(boundaryB) and math.abs(boundaryA-boundaryB) >= 2*syminfo.mintick
        float lo = math.min(boundaryA,boundaryB)
        float hi = math.max(boundaryA,boundaryB)
        for depth = 0 to wbNestedDepth
            float center = math.avg(lo,hi)
            array.push(hierarchyTriples,lo)
            array.push(hierarchyTriples,center)
            array.push(hierarchyTriples,hi)
            array.push(hierarchyNames,name+(depth > 0 ? " · half "+str.tostring(depth) : ""))
            array.push(hierarchyTiers,tier)
            // Narrow within this same established range, not into unrelated calendar pairs.
            if close >= center
                lo := center
            else
                hi := center
    0
f_hierarchy() =>
    array.clear(hierarchyTriples)
    array.clear(hierarchyNames)
    array.clear(hierarchyTiers)
    if wbShowYear
        f_namedBox("YEAR · PYH / PYL",0,prevyear_high,prevyear_low)
    if wbShowQuarter
        f_namedBox("QUARTER · PQH / PQL",1,quarterlyh_open,quarterlyl_open)
    if wbShowMonth
        f_namedBox("MONTH · PMH / MO",2,monthlyh_open,monthly_open)
    if wbShowWeek
        f_namedBox("WEEK · PWH / PWL",3,weeklyh_open,weeklyl_open)
        float pwm = math.avg(weeklyh_open,weeklyl_open)
        float first = wbWeekPair == "Previous Week Mid / Previous Month High" ? pwm : wbWeekPair == "Previous Week High / Previous Week Low" ? weeklyh_open : weekly_open
        float second = wbWeekPair == "Weekly Open / Previous Month High" or wbWeekPair == "Previous Week Mid / Previous Month High" ? monthlyh_open : wbWeekPair == "Weekly Open / Previous Week Mid" ? pwm : weeklyl_open
        f_namedBox("WEEK reaction · "+wbWeekPair,3,first,second)
        if wbWeekOpenMid and wbWeekPair != "Weekly Open / Previous Week Mid"
            f_namedBox("WEEK · WO / PWM",3,weekly_open,pwm)
    if wbShowDay and wbDailyEstablished and not flareMonday
        f_namedBox("DAY · DO / MON-L",4,daily_open,monday_low)
    0

gT = "Tests (held / broken)"
showTests = input.bool(false, "Show held/broken counts on level labels", group = gT)
showBarMarks  = input.bool(false, "Mark held/broken dots on the bar", group = gT)
barMarksQuart = input.bool(true, "Also mark quartile levels",         group = gT)
// Optional dots show held/broken map tests, separate from bull/bear confirmations.

colActive = input.color(#00E5FF,'Active quartiles',group=gS)
colDorm = input.color(#5364A8,'Other quartiles',group=gS)
colZone = input.color(color.new(#00E5FF,95),'Structure fill',group=gS)
NMAJ  = 67
NSLOT = NMAJ + (NMAJ - 1) * 3

var float[]  stPrice = array.new_float(NSLOT, na)
var int[]    stSide  = array.new_int(NSLOT, 0)
var bool[]   stTouch = array.new_bool(NSLOT, false)
var string[] stMarks = array.new_string(NSLOT, "")
var int[]    stHeld  = array.new_int(NSLOT, 0)
var int[]    stBroke = array.new_int(NSLOT, 0)
var int[]    stBullAccept = array.new_int(NSLOT, 0)
var int[]    stBearAccept = array.new_int(NSLOT, 0)
var int[]    stSupportHold = array.new_int(NSLOT, 0)
var int[]    stResistanceHold = array.new_int(NSLOT, 0)
var int[]    stLastState = array.new_int(NSLOT, 0)  // 2 bull accept, 1 support hold, -1 rejection, -2 bear accept

f_reset(s) =>
    array.set(stSide,  s, 0)
    array.set(stTouch, s, false)
    array.set(stMarks, s, "")
    array.set(stHeld,  s, 0)
    array.set(stBroke, s, 0)
    array.set(stBullAccept, s, 0)
    array.set(stBearAccept, s, 0)
    array.set(stSupportHold, s, 0)
    array.set(stResistanceHold, s, 0)
    array.set(stLastState, s, 0)

f_mark(s, held) =>
    if held
        array.set(stHeld, s, array.get(stHeld, s) + 1)
    else
        array.set(stBroke, s, array.get(stBroke, s) + 1)

f_track(s, p) =>
    int  evt = 0                                   // 0 none · 1 held · -1 broke (this bar)
    bool up  = false                               // did the bar close ABOVE the line?
    if not na(p)
        old = array.get(stPrice, s)
        if na(old) or math.abs(old - p) > syminfo.mintick * 0.5
            array.set(stPrice, s, p)
            f_reset(s)
        if barstate.isconfirmed
            crossed = low <= p and high >= p               // the bar's range spans the line
            oldSide = array.get(stSide, s)                 // side it came from (last bar clear of the line)
            armed   = array.get(stTouch, s)                // ready to register a new test
            if crossed
                if armed and oldSide != 0
                    closeSide = close >= p ? 1 : -1
                    held = closeSide == oldSide             // closed back on the side it came from → held
                    f_mark(s, held)
                    if held and closeSide == 1
                        array.set(stSupportHold, s, array.get(stSupportHold, s) + 1)
                        array.set(stLastState, s, 1)
                    else if held and closeSide == -1
                        array.set(stResistanceHold, s, array.get(stResistanceHold, s) + 1)
                        array.set(stLastState, s, -1)
                    else if not held and closeSide == 1
                        array.set(stBullAccept, s, array.get(stBullAccept, s) + 1)
                        array.set(stLastState, s, 2)
                    else
                        array.set(stBearAccept, s, array.get(stBearAccept, s) + 1)
                        array.set(stLastState, s, -2)
                    evt := held ? 1 : -1
                    up  := closeSide == 1
                    array.set(stTouch, s, false)           // registered — wait until price leaves the line
            else
                clearSide = close > p ? 1 : -1
                bool gapAccepted = armed and oldSide != 0 and clearSide != oldSide
                if gapAccepted
                    f_mark(s, false)
                    if clearSide == 1
                        array.set(stBullAccept, s, array.get(stBullAccept, s) + 1)
                        array.set(stLastState, s, 2)
                    else
                        array.set(stBearAccept, s, array.get(stBearAccept, s) + 1)
                        array.set(stLastState, s, -2)
                    evt := -1
                    up := clearSide == 1
                    array.set(stTouch, s, false)
                else
                    array.set(stTouch, s, true)             // bar clear of the line → re-arm for next test
                array.set(stSide, s, clearSide)             // remember which side price is on
    [evt, up]

f_statsTxt(s) =>
    h = array.get(stHeld,  s)
    b = array.get(stBroke, s)
    n = h + b
    state = array.get(stLastState, s)
    stateText = state == 2 ? "Bull accepted" : state == 1 ? "Support held" : state == -1 ? "Rejected / weak" : state == -2 ? "Bear accepted" : "Neutral"
    (not showTests or n == 0) ? "" : " • Held " + str.tostring(h) + " / Broken " + str.tostring(b) + " • " + str.tostring(math.round(100.0 * h / n)) + "% held • " + stateText

f_slotBull(int slot) =>
    array.get(stBullAccept, slot) + array.get(stSupportHold, slot)

f_slotBear(int slot) =>
    array.get(stBearAccept, slot) + array.get(stResistanceHold, slot)

f_boxDirectionalStats(int historicalBull, int historicalBear, int slotA, int slotB, int slotCenter) =>
    int bullEvents = historicalBull + f_slotBull(slotA) + f_slotBull(slotB) + f_slotBull(slotCenter)
    int bearEvents = historicalBear + f_slotBear(slotA) + f_slotBear(slotB) + f_slotBear(slotCenter)
    int events = bullEvents + bearEvents
    int bullPct = events == 0 ? 50 : int(math.round(100.0 * bullEvents / events))
    string direction = bullPct >= 50 ? "BULL" : "BEAR"
    int strengthPct = math.max(bullPct, 100 - bullPct)
    string letter = events < wbMinGradeTests ? "BUILDING" : strengthPct >= 85 ? "A+" : strengthPct >= 75 ? "A" : strengthPct >= 60 ? "B" : "C"
    [bullPct, strengthPct, events, direction, letter]

f_boxPosition(float boundaryA, float boundaryB) =>
    float bottom = math.min(boundaryA, boundaryB)
    float top = math.max(boundaryA, boundaryB)
    float span = math.max(top - bottom, syminfo.mintick)
    int(math.round(100.0 * (close - bottom) / span))

f_boxState(int slotCenter) =>
    int state = array.get(stLastState, slotCenter)
    state == 2 ? "BULL ACCEPTED" : state == 1 ? "SUPPORT HELD" : state == -1 ? "REJECTED / WEAK" : state == -2 ? "BEAR ACCEPTED" : close >= array.get(stPrice, slotCenter) ? "ABOVE CENTER" : "BELOW CENTER"

f_boxGradeColor(int bullPct, int events, color identityColor) =>
    not wbGradeBoxes or events < wbMinGradeTests ? identityColor : bullPct >= 55 ? #39FF14 : bullPct <= 45 ? #FF1493 : #FFFF00

f_boxCaption(string name, int strengthPct, int events, string direction, string letter, string state, int positionPct) =>
    string eventText = events == 1 ? "1 EVENT" : str.tostring(events) + " EVENTS"
    string gradeText = not wbGradeBoxes ? "" : events == 0 ? " • UNTESTED" : " • " + letter + " " + direction + " " + str.tostring(strengthPct) + "% • " + eventText
    string positionText = positionPct < 0 ? " • PRICE BELOW" : positionPct > 100 ? " • PRICE ABOVE" : " • PRICE " + str.tostring(positionPct) + "%"
    name + gradeText + " • " + state + positionText

// Preserve completed-week samples before f_track resets the moving weekly
// prices. This makes each box grade cumulative across all history loaded on
// the chart while still including the live week's confirmed tests.
var int wb1HistoricalBull = 0
var int wb1HistoricalBear = 0
var int wb2HistoricalBull = 0
var int wb2HistoricalBear = 0
var int wb3HistoricalBull = 0
var int wb3HistoricalBear = 0
if barstate.isconfirmed and timeframe.change('W') and not barstate.isfirst
    wb1HistoricalBull += f_slotBull(11) + f_slotBull(12) + f_slotBull(37)
    wb1HistoricalBear += f_slotBear(11) + f_slotBear(12) + f_slotBear(37)
    wb2HistoricalBull += f_slotBull(12) + f_slotBull(37) + f_slotBull(38)
    wb2HistoricalBear += f_slotBear(12) + f_slotBear(37) + f_slotBear(38)
    wb3HistoricalBull += f_slotBull(37) + f_slotBull(38) + f_slotBull(39)
    wb3HistoricalBear += f_slotBear(37) + f_slotBear(38) + f_slotBear(39)
    f_reset(11)
    f_reset(12)
    f_reset(37)
    f_reset(38)
    f_reset(39)

